  "exceptions": {
    "dev": [
      {
        "dimension": "apis",
        "remove": [
          "androidpublisher.googleapis.com"
        ],
        "reason": "The Play Developer API is called only by the release tooling's service account, which lives in the prod project (scripts/lib/play.mjs); dev and beta never call it."
      },
      {
        "dimension": "iam",
        "add": [
          "serviceAccount:business-publisher@<project>.iam.gserviceaccount.com roles/datastore.user",
          "serviceAccount:business-publisher@<project>.iam.gserviceaccount.com roles/firebase.viewer",
          "serviceAccount:business-publisher@<project>.iam.gserviceaccount.com roles/firebasehosting.admin",
          "serviceAccount:business-publisher@<project>.iam.gserviceaccount.com roles/serviceusage.serviceUsageConsumer"
        ],
        "reason": "The business repo's deploy publishes _admin/businessSnapshot and the founders' panel to the dev project only (AGENTS.md, business split)."
      },
      {
        "dimension": "iam",
        "remove": [
          "serviceAccount:firebase-measurement@system.gserviceaccount.com roles/bigquery.user",
          "serviceAccount:firebase-measurement@system.gserviceaccount.com roles/logging.logWriter"
        ],
        "reason": "GA4 \u2192 BigQuery export (Firebase measurement writing to BigQuery) runs on prod only; dev and beta analytics are not exported."
      },
      {
        "dimension": "authDomains",
        "add": [
          "cultuvilla-panel.web.app"
        ],
        "reason": "The founders' panel is a second hosting site that exists on dev only (hostingTargets.test.ts)."
      },
      {
        "dimension": "authDomains",
        "remove": [
          "cultuvilla.es"
        ],
        "reason": "cultuvilla.es is prod's custom domain; dev and beta are served from their own web.app hosts."
      },
      {
        "dimension": "firestore",
        "set": {
          "pointInTimeRecoveryEnablement": "POINT_IN_TIME_RECOVERY_DISABLED"
        },
        "reason": "Point-in-time recovery is a paid backup feature kept for production data only."
      }
    ],
    "beta": [
      {
        "dimension": "apis",
        "remove": [
          "androidpublisher.googleapis.com"
        ],
        "reason": "The Play Developer API is called only by the release tooling's service account, which lives in the prod project (scripts/lib/play.mjs); dev and beta never call it."
      },
      {
        "dimension": "iam",
        "remove": [
          "serviceAccount:firebase-measurement@system.gserviceaccount.com roles/bigquery.user",
          "serviceAccount:firebase-measurement@system.gserviceaccount.com roles/logging.logWriter"
        ],
        "reason": "GA4 \u2192 BigQuery export (Firebase measurement writing to BigQuery) runs on prod only; dev and beta analytics are not exported."
      },
      {
        "dimension": "authDomains",
        "remove": [
          "cultuvilla.es"
        ],
        "reason": "cultuvilla.es is prod's custom domain; dev and beta are served from their own web.app hosts."
      },
      {
        "dimension": "firestore",
        "set": {
          "pointInTimeRecoveryEnablement": "POINT_IN_TIME_RECOVERY_DISABLED"
        },
        "reason": "Point-in-time recovery is a paid backup feature kept for production data only."
      }
    ]
