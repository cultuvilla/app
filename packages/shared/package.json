{
  "name": "@cultuvilla/shared",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./firebase/refs/client": {
      "types": "./dist/firebase/refs/client.d.ts",
      "default": "./dist/firebase/refs/client.js"
    },
    "./firebase/refs/admin": {
      "types": "./dist/firebase/refs/admin.d.ts",
      "default": "./dist/firebase/refs/admin.js"
    },
    "./firebase/sdk/firestore": {
      "types": "./dist/firebase/sdk/firestore.d.ts",
      "react-native": "./dist/firebase/sdk/firestore.native.js",
      "default": "./dist/firebase/sdk/firestore.js"
    },
    "./firebase/sdk/auth": {
      "types": "./dist/firebase/sdk/auth.d.ts",
      "react-native": "./dist/firebase/sdk/auth.native.js",
      "default": "./dist/firebase/sdk/auth.js"
    },
    "./firebase/sdk/functions": {
      "types": "./dist/firebase/sdk/functions.d.ts",
      "react-native": "./dist/firebase/sdk/functions.native.js",
      "default": "./dist/firebase/sdk/functions.js"
    },
    "./firebase/sdk/storage": {
      "types": "./dist/firebase/sdk/storage.d.ts",
      "react-native": "./dist/firebase/sdk/storage.native.js",
      "default": "./dist/firebase/sdk/storage.js"
    },
    "./firebase/sdk/errors": {
      "types": "./dist/firebase/sdk/errors.d.ts",
      "default": "./dist/firebase/sdk/errors.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./legal": {
      "types": "./dist/legal/index.d.ts",
      "default": "./dist/legal/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./design-system": {
      "types": "./dist/design-system/index.d.ts",
      "default": "./dist/design-system/index.js"
    },
    "./wrapped": {
      "types": "./dist/wrapped/index.d.ts",
      "default": "./dist/wrapped/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:rules": "vitest run --config vitest.config.e2e.ts",
    "test:all": "vitest run --config vitest.config.all.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "vitest run --config vitest.config.all.ts --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-firebase/storage": "^26.4.0",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-firebase/app": {
      "optional": true
    },
    "@react-native-firebase/auth": {
      "optional": true
    },
    "@react-native-firebase/firestore": {
      "optional": true
    },
    "@react-native-firebase/functions": {
      "optional": true
    },
    "@react-native-firebase/storage": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-native-firebase/storage": "^26.4.0",
    "@types/react": "^19.0.0",
    "firebase": "^11.0.0",
    "react": "^19.1.0",
    "react-native": "0.85.3",
    "typescript": "~5.8.3",
    "vitest": "^4.0.15"
  }
}
