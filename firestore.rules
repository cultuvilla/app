rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAppAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isVillageAdmin(municipalityId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/municipalities/$(municipalityId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/municipalities/$(municipalityId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    function isVillageMember(municipalityId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/municipalities/$(municipalityId)/members/$(request.auth.uid));
    }
    function isCommunityActive(municipalityId) {
      return exists(/databases/$(database)/documents/municipalities/$(municipalityId))
        && get(/databases/$(database)/documents/municipalities/$(municipalityId)).data.communityActive == true;
    }
    function isOrgMember(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }
    function isOrgAdmin(orgId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
    }
    function orgMunicipalityId(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.municipalityId;
    }
    // Organizer of an event: a user in the event's organizerUserIds, a village
    // admin of the event's municipality, or an app admin. Used to gate the
    // attendee roster (check-in, remove, organizer-only phone contacts).
    // Note: org members listed in organizerOrgIds do NOT get organizer access —
    // orgs are display-only.
    function isEventOrganizer(eventId) {
      return isAuthenticated() && (
        isAppAdmin()
        || (request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.organizerUserIds)
        || isVillageAdmin(get(/databases/$(database)/documents/events/$(eventId)).data.municipalityId)
      );
    }

    // The attendee roster is a pueblo-wide read, not a public one: a member of
    // the event's village may see who is going, unless the organizer set the
    // event to `organizers`. Deliberately touches no `resource` field, so a
    // list query over the subcollection is evaluated once (and passes or fails
    // as a whole) rather than per document.
    // `.get(key, default)` mirrors AttendeesVisibilitySchema's `.default()`,
    // so events written before the field existed behave as `members`.
    function isRosterVisibleToVillage(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return event.get('attendeesVisibility', 'members') == 'members'
        && isVillageMember(event.municipalityId)
        // A private event's roster is org-wide, not pueblo-wide: the pueblo
        // cannot see the event, so it must not see who is going to it either.
        // An attendee from outside the org still reaches their own row through
        // the per-document branch below.
        && (event.get('visibilityOrgId', null) == null || isOrgMember(event.visibilityOrgId));
    }

    // Who may see a private event at all. Village admins are deliberately
    // absent: a peña's internal event is not the pueblo's public square, and
    // giving the village's leadership a read here would defeat the feature.
    // The org pointer, not the enum, is the gate — a doc claiming to be private
    // with no org named fails closed everywhere rather than half-open.
    // Cheapest branch first: a public event costs no document reads at all.
    function canReadEvent(event) {
      return event.get('visibilityOrgId', null) == null
        || isOrgMember(event.visibilityOrgId)
        || (isAuthenticated() && request.auth.uid in event.organizerUserIds)
        || isAppAdmin();
    }

    // Changing who an event is visible to is not ordinary moderation. A village
    // admin keeps edit/cancel authority over every event in their pueblo but
    // must not be able to blind-write a peña's private event back into public
    // view; and nobody may hide an event inside an org they don't belong to.
    function isValidVisibilityChange(before, after) {
      let beforeOrg = before.get('visibilityOrgId', null);
      let afterOrg = after.get('visibilityOrgId', null);
      return (after.get('visibility', 'public') == 'organization') == (afterOrg != null)
        && (
             afterOrg == beforeOrg
             || (
                  ((isAuthenticated() && request.auth.uid in before.organizerUserIds) || isAppAdmin())
                  && (afterOrg == null || isOrgMember(afterOrg) || isAppAdmin())
                )
           );
    }

    // ── Shape validation helpers ─────────────────────────────────────────
    // These mirror the Zod schemas in packages/shared/src/models/*. Any
    // change to a model must update the matching helper here. The CI grep
    // gate in scripts/check-no-raw-collection.mjs enforces typed-ref usage
    // in code, but rules are the only defense against direct console writes
    // or any path that forgets to use a typed ref.
    //
    // Shape predicates check:
    //   - hasOnly([...])  — no unknown keys
    //   - hasAll([...])   — required keys present
    //   - type checks     — critical fields have the right runtime type
    //
    // A `safeParse` derivation script (scripts/audit-firestore-shapes.ts —
    // todo) walks production data and reports any docs that would fail
    // strict converter parse. Run it before each beta promotion.

    function isString(v) { return v is string; }
    function isStringOrNull(v) { return v == null || v is string; }
    function isNumberOrNull(v) { return v == null || v is number; }
    function isBool(v) { return v is bool; }
    function isTimestamp(v) { return v is timestamp; }
    function isTimestampOrNull(v) { return v == null || v is timestamp; }
    function isList(v) { return v is list; }
    function isMap(v) { return v is map; }
    function isMapOrNull(v) { return v == null || v is map; }
    // GeoPoint fields (the converter writes {lat,lng} -> GeoPoint, rules type `latlng`).
    function isLatLngOrNull(v) { return v == null || v is latlng; }

    function isValidPartialDate(v) {
      return v == null || (
        v is map
        && v.keys().hasOnly(['year', 'month', 'day'])
        && v.keys().hasAll(['year', 'month', 'day'])
        && (v.year == null || v.year is number)
        && (v.month == null || v.month is number)
        && (v.day == null || v.day is number)
      );
    }

    // ── Per-collection shape predicates (create payloads) ────────────────

    // /users/{userId} on create: clients omit `displayName` (the
    // syncPersonDenormalization function fills it). All other UserData
    // fields must be present.
    function hasValidUserFields(d) {
      return isString(d.email)
          && isStringOrNull(d.telephone)
          && isStringOrNull(d.activeMunicipalityId)
          && isStringOrNull(d.personId)
          && isTimestamp(d.createdAt)
          && isTimestamp(d.termsAcceptedAt)
          && isString(d.termsVersion);
    }

    function isValidUserCreate(d) {
      return d.keys().hasOnly([
              'email', 'telephone', 'activeMunicipalityId', 'personId', 'createdAt',
              'termsAcceptedAt', 'termsVersion',
            ])
          && d.keys().hasAll([
              'email', 'telephone', 'activeMunicipalityId', 'personId', 'createdAt',
              'termsAcceptedAt', 'termsVersion',
            ])
          && hasValidUserFields(d);
    }

    // /users/{userId} on update: same field set as create minus `displayName`
    // (denormalized by the Cloud Function; clients must never touch it). The
    // profile (birthday/biography/photoURL) lives on the linked person.
    function isValidUserUpdateKeys(affected) {
      return affected.hasOnly([
        'email', 'telephone', 'activeMunicipalityId', 'personId',
        'termsAcceptedAt', 'termsVersion',
      ]);
    }

    // A client-writable `email` must equal the caller's verified Auth token
    // claim — otherwise a user could spoof any email onto their own profile.
    function isEmailUpdateVerified(reqData, affected) {
      return !affected.hasAny(['email']) || reqData.email == request.auth.token.email;
    }

    // Onboarding race: createPerson() fires syncPersonDenormalization, which
    // pre-creates users/{uid} carrying only `displayName`. The client's
    // subsequent createUserProfile() setDoc(merge) then lands on the UPDATE
    // path and carries `createdAt`. Allow that one-time set — but only when no
    // createdAt exists yet (it stays immutable afterwards) and the merged
    // fields validate. `displayName` is excluded from the affected keys, so a
    // client still can't overwrite it on this path.
    function isOnboardingUserMerge(reqData, resData) {
      return !('createdAt' in resData)
          && reqData.diff(resData).affectedKeys().hasOnly([
               'email', 'telephone', 'activeMunicipalityId', 'personId', 'createdAt',
               'termsAcceptedAt', 'termsVersion',
             ])
          && hasValidUserFields(reqData);
    }

    function isValidNewsPostCreate(d) {
      return d.keys().hasOnly([
              'municipalityId', 'villageSlug', 'organizerUserIds', 'organizerOrgIds', 'title', 'body',
              'content', 'category', 'images', 'coverImage', 'status', 'hiddenBy',
              'hiddenAt', 'hiddenReason', 'createdAt', 'publishedAt', 'createdBy',
              'updatedAt', 'readCount', 'commentCount',
            ])
          && d.keys().hasAll([
              'municipalityId', 'villageSlug', 'organizerUserIds', 'organizerOrgIds', 'title', 'body',
              'content', 'category', 'images', 'coverImage', 'status', 'hiddenBy',
              'hiddenAt', 'hiddenReason', 'createdAt', 'publishedAt', 'createdBy',
              'updatedAt', 'readCount', 'commentCount',
            ])
          && isString(d.municipalityId)
          && isString(d.villageSlug)
          && d.organizerUserIds is list
          && d.organizerOrgIds is list
          && isString(d.title)
          && isString(d.body)
          && isList(d.content)
          && d.category in ['fiesta', 'tradicion', 'gastronomia', 'historia', 'otro']
          && isList(d.images)
          && isMapOrNull(d.coverImage)
          && d.status == 'active'
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          && isTimestamp(d.createdAt)
          && isTimestampOrNull(d.publishedAt)
          && isString(d.createdBy)
          && isTimestamp(d.updatedAt)
          && d.readCount == 0
          && d.commentCount is number;
    }

    function isValidPersonCreate(d) {
      return d.keys().hasOnly([
              'givenName', 'middleNames', 'firstSurname', 'secondSurname',
              'nickname', 'sex', 'birthday', 'deathDate', 'birthPlace',
              'burialPlace', 'municipalityLinks', 'occupations',
              'biography', 'photoURL', 'userId', 'isPublic',
              'createdBy', 'createdAt',
            ])
          && d.keys().hasAll([
              'givenName', 'middleNames', 'firstSurname', 'secondSurname',
              'nickname', 'sex', 'birthday', 'deathDate', 'birthPlace',
              'burialPlace', 'municipalityLinks', 'occupations',
              'biography', 'photoURL', 'userId', 'isPublic',
              'createdBy', 'createdAt',
            ])
          && isString(d.givenName)
          && isList(d.middleNames)
          && isStringOrNull(d.firstSurname)
          && isStringOrNull(d.secondSurname)
          && isStringOrNull(d.nickname)
          && (d.sex == null || d.sex in ['male', 'female', 'other'])
          && isValidPartialDate(d.birthday)
          && isValidPartialDate(d.deathDate)
          && isMapOrNull(d.birthPlace)
          && isMapOrNull(d.burialPlace)
          && isList(d.municipalityLinks)
          && isList(d.occupations)
          && isStringOrNull(d.biography)
          && isStringOrNull(d.photoURL)
          && isStringOrNull(d.userId)
          && d.isPublic is bool
          && isString(d.createdBy)
          && isTimestamp(d.createdAt);
    }

    // Privacy is a dependent-persona feature: an account holder's persona is
    // their public face in the pueblo, so it can never be hidden.
    function isPublicUnlessDependent(d) {
      return d.userId == null || d.isPublic == true;
    }

    function isValidCensoAnswersWrite(d) {
      return d.keys().hasOnly(['municipalityId', 'userId', 'profileAnswers', 'updatedAt'])
          && d.keys().hasAll(['municipalityId', 'userId', 'profileAnswers', 'updatedAt'])
          && isString(d.municipalityId)
          && isString(d.userId)
          && isMap(d.profileAnswers)
          && isTimestamp(d.updatedAt);
    }

    function isValidOrgJoinRequestCreate(d, orgId, userId) {
      return d.keys().hasOnly(['userId', 'orgId', 'municipalityId', 'createdAt'])
          && d.keys().hasAll(['userId', 'orgId', 'municipalityId', 'createdAt'])
          && d.userId == userId
          && d.orgId == orgId
          && d.municipalityId == orgMunicipalityId(orgId)
          && isTimestamp(d.createdAt);
    }

    function isValidOrgFollowerCreate(d, orgId, userId) {
      return d.keys().hasOnly(['userId', 'orgId', 'municipalityId', 'createdAt'])
          && d.keys().hasAll(['userId', 'orgId', 'municipalityId', 'createdAt'])
          && d.userId == userId
          && d.orgId == orgId
          && d.municipalityId == orgMunicipalityId(orgId)
          && isTimestamp(d.createdAt);
    }

    function isValidOrgMemberCreate(d) {
      return d.keys().hasOnly(['userId', 'joinedAt', 'role'])
          && d.keys().hasAll(['userId', 'joinedAt', 'role'])
          && isString(d.userId)
          && isTimestamp(d.joinedAt)
          && d.role in ['admin', 'member'];
    }

    function isValidOrganizationCreate(d) {
      return d.keys().hasOnly([
              'name', 'description', 'images', 'type', 'status', 'municipalityId', 'villageSlug',
              'requestedBy', 'reviewedBy', 'createdAt', 'reviewedAt',
              'commentCount', 'readCount', 'memberCount', 'followerCount', 'membersPublic', 'joinPolicy',
              'sociosListVisible', 'chatAdminsOnly',
            ])
          && d.keys().hasAll([
              'name', 'description', 'images', 'type', 'status', 'municipalityId', 'villageSlug',
              'requestedBy', 'reviewedBy', 'createdAt', 'reviewedAt',
              'commentCount', 'readCount', 'memberCount', 'membersPublic',
            ])
          && isString(d.name)
          && isStringOrNull(d.description)
          && isList(d.images) && d.images.size() <= 5
          && d.type in ['ayuntamiento', 'peña', 'asociación', 'otros']
          && d.status in ['pending', 'approved', 'rejected']
          && isString(d.municipalityId)
          && isString(d.villageSlug)
          && isString(d.requestedBy)
          && isStringOrNull(d.reviewedBy)
          && isTimestamp(d.createdAt)
          && isTimestampOrNull(d.reviewedAt)
          && d.commentCount == 0
          && d.readCount == 0
          && d.memberCount == 0
          && d.get('followerCount', 0) == 0
          && d.membersPublic is bool
          // Installed binaries still send `open`; approveOrganization overwrites
          // it, so no approved org is ever open.
          && d.get('joinPolicy', 'open') in ['open', 'approval']
          && d.get('sociosListVisible', false) is bool
          && d.get('chatAdminsOnly', false) is bool;
    }

    // ── Socio roster (organizations/{orgId}/socios, socioPrivate) ─────────────
    // Only peñas, asociaciones, otros and comisiones keep one; the ayuntamiento has none.
    function orgHasSocioRoster(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.type
        in ['peña', 'asociación', 'otros', 'comisión'];
    }
    // "Los estatutos permiten ver la lista de socios" — names only, never contact.
    function orgSociosListVisible(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('sociosListVisible', false) == true;
    }
    // The group's "nº de socio" (SOCIO_NUMBER_MAX). Uniqueness is the admins'
    // care: rules cannot see the other rows.
    function isValidSocioNumber(n) {
      return n == null || (n is int && n >= 1 && n <= 99999);
    }
    function isValidSocioCreate(d) {
      return d.keys().hasOnly([
              'kind', 'socioNumber', 'displayName', 'uid', 'personId', 'responsibleUid', 'adminTitle',
              'altaAt', 'bajaAt', 'memberJoinedAt', 'createdBy',
            ])
          && d.keys().hasAll([
              'kind', 'socioNumber', 'displayName', 'uid', 'personId', 'responsibleUid', 'adminTitle',
              'altaAt', 'bajaAt', 'memberJoinedAt', 'createdBy',
            ])
          && d.kind in ['persona', 'typed']
          && isValidSocioNumber(d.socioNumber)
          && isString(d.displayName) && d.displayName.size() > 0 && d.displayName.size() <= 200
          && d.uid == null
          && isStringOrNull(d.personId)
          && isStringOrNull(d.responsibleUid)
          && d.adminTitle == null
          && isTimestamp(d.altaAt)
          && d.bajaAt == null
          && d.memberJoinedAt == null
          && d.createdBy == request.auth.uid;
    }
    // A persona a cargo may be a socio only while it is one: created by the
    // caller, with no account of its own (one who claimed it joins as a member)
    // and alive — the same test MyPersonasSocios applies.
    function isEligiblePersona(personId) {
      let p = get(/databases/$(database)/documents/persons/$(personId)).data;
      return p.createdBy == request.auth.uid
        && p.get('userId', null) == null
        && p.get('deathDate', null) == null
        && p.get('burialPlace', null) == null;
    }
    // ── Group messages (organizations/{orgId}/messages) ──────────────────────
    function groupMessage(orgId, messageId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/messages/$(messageId)).data;
    }
    function isValidGroupPollVote(message, uid, d) {
      return message.poll != null
          && uid in message.recipientUids
          && d.keys().hasOnly(['option', 'votedAt'])
          && d.keys().hasAll(['option', 'votedAt'])
          && d.option is int
          && d.option >= 0
          && d.option < message.poll.options.size()
          && d.votedAt == request.time;
    }

    // ── Group chat (see GroupChatDataModel) ───────────────────────────────────
    // An aviso's thread is read by whoever reads the aviso: the admins and its
    // recipients, while still members. The general thread is every member's.
    function canReadAvisoChat(orgId, messageId) {
      return isOrgAdmin(orgId)
        || (isOrgMember(orgId) && request.auth.uid in groupMessage(orgId, messageId).recipientUids);
    }
    function canReadGroupChatThread(orgId, threadId) {
      return threadId == 'general' ? isOrgMember(orgId) : canReadAvisoChat(orgId, threadId);
    }
    // "Solo la junta escribe" — the general thread only.
    function orgChatAdminsOnly(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('chatAdminsOnly', false) == true;
    }
    // The author writes as themself, under their public name, now.
    function isValidGroupChatMessageCreate(d) {
      return d.keys().hasOnly(['authorUid', 'authorName', 'body', 'createdAt'])
          && d.keys().hasAll(['authorUid', 'authorName', 'body', 'createdAt'])
          && d.authorUid == request.auth.uid
          && isString(d.authorName) && d.authorName.size() > 0
          && d.authorName == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.displayName
          && isString(d.body) && d.body.size() > 0 && d.body.size() <= 2000
          && d.createdAt == request.time;
    }
    // Authors delete their own; the group's admins anyone's, with the village's
    // and the app's admins as the backstop. No message is ever edited.
    function canDeleteGroupChatMessage(orgId, message) {
      return isOwner(message.authorUid)
        || isOrgAdmin(orgId)
        || isVillageAdmin(orgMunicipalityId(orgId))
        || isAppAdmin();
    }

    // ── Cuota de socios (cuotaSettings, cuotaAssignments, cuotaPayments) ──────
    // The socio row a cuota doc points at. Members read the cuota docs of the
    // rows they are (uid) or answer for (responsibleUid, a persona a cargo).
    function socioRow(orgId, socioId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data;
    }
    function isMySocioRow(orgId, socioId) {
      let row = socioRow(orgId, socioId);
      return isAuthenticated()
        && (row.uid == request.auth.uid || row.responsibleUid == request.auth.uid);
    }
    function isCents(v) {
      return v is int && v >= 0 && v <= 1000000;
    }
    function isPeriodKey(v) {
      return v is string && v.matches('^[0-9]{4}(-(0[1-9]|1[0-2]))?$');
    }
    function isDayKey(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isNullOrShortString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function isValidCuotaSettings(d) {
      return d.keys().hasOnly([
              'amountCents', 'periodicity', 'dueMonth', 'dueDay', 'graceDays', 'startPeriod', 'tiers',
              'bizum', 'iban', 'payInstructions', 'remindersEnabled', 'configuredBy', 'updatedAt',
            ])
          && d.keys().hasAll([
              'amountCents', 'periodicity', 'dueMonth', 'dueDay', 'graceDays', 'startPeriod', 'tiers',
              'bizum', 'iban', 'payInstructions', 'remindersEnabled', 'configuredBy', 'updatedAt',
            ])
          && isCents(d.amountCents)
          && d.periodicity in ['yearly', 'monthly']
          && d.dueMonth is int && d.dueMonth >= 1 && d.dueMonth <= 12
          && d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31
          && d.graceDays is int && d.graceDays >= 0 && d.graceDays <= 365
          && isPeriodKey(d.startPeriod)
          && d.tiers is list && d.tiers.size() <= 10
          && isNullOrShortString(d.bizum, 40)
          && isNullOrShortString(d.iban, 40)
          && isNullOrShortString(d.payInstructions, 500)
          && d.remindersEnabled is bool
          && d.configuredBy == request.auth.uid
          && d.updatedAt == request.time;
    }
    function isValidCuotaAssignment(d) {
      return d.keys().hasOnly(['tierId', 'exempt', 'customAmountCents', 'updatedBy', 'updatedAt'])
          && d.keys().hasAll(['tierId', 'exempt', 'customAmountCents', 'updatedBy', 'updatedAt'])
          && isNullOrShortString(d.tierId, 40)
          && d.exempt is bool
          && (d.customAmountCents == null || isCents(d.customAmountCents))
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
    }
    function isValidCuotaPayment(d) {
      return d.keys().hasOnly([
              'socioId', 'periodKey', 'kind', 'reversesId', 'amountCents', 'method', 'paidOn',
              'note', 'recordedBy', 'recordedAt',
            ])
          && d.keys().hasAll([
              'socioId', 'periodKey', 'kind', 'reversesId', 'amountCents', 'method', 'paidOn',
              'note', 'recordedBy', 'recordedAt',
            ])
          && d.socioId is string
          && isPeriodKey(d.periodKey)
          && isCents(d.amountCents) && d.amountCents > 0
          && d.method in ['efectivo', 'bizum', 'transferencia', 'domiciliacion']
          && isDayKey(d.paidOn)
          && isNullOrShortString(d.note, 500)
          && d.recordedBy == request.auth.uid
          && d.recordedAt == request.time;
    }

    // ── Group tasks (tasks, taskTemplates) ──────────────────────────────────
    // See GroupTaskDataModel. The three shift answer lists and nextTaskId are
    // function-owned (respondToTaskShift, onGroupTaskUpdated).
    function isTimeOfDay(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function isValidTaskRecurrence(r) {
      return r == null
        || (r is map
          && r.keys().hasOnly(['kind', 'unit', 'interval', 'anchorOn'])
          && r.keys().hasAll(['kind', 'unit', 'interval', 'anchorOn'])
          && r.unit in ['month', 'year']
          && r.interval is int && r.interval >= 1 && r.interval <= 24
          && ((r.kind == 'calendar' && isDayKey(r.anchorOn))
            || (r.kind == 'afterDone' && (r.anchorOn == null || isDayKey(r.anchorOn)))));
    }
    function groupTaskKeys() {
      return [
        'title', 'notes', 'assigneeUids', 'dueOn', 'time', 'slots', 'claimedUids', 'waitlistUids',
        'declinedUids', 'recurrence', 'nextTaskId', 'eventId', 'doneAt', 'doneBy', 'createdBy', 'createdAt',
      ];
    }
    // The fields an admin edits, and how they hang together.
    function isValidGroupTaskFields(d) {
      return d.keys().hasOnly(groupTaskKeys())
          && d.keys().hasAll(groupTaskKeys())
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
          && isNullOrShortString(d.notes, 1000)
          && d.assigneeUids is list && d.assigneeUids.size() <= 20
          && (d.dueOn == null || isDayKey(d.dueOn))
          && (d.time == null || isTimeOfDay(d.time))
          && (d.slots == null || (d.slots is int && d.slots >= 1 && d.slots <= 100 && d.dueOn != null))
          && isValidTaskRecurrence(d.recurrence)
          && (d.recurrence == null || d.recurrence.kind != 'calendar' || d.dueOn != null)
          && (d.eventId == null || d.eventId is string)
          && d.claimedUids is list && d.waitlistUids is list && d.declinedUids is list;
    }
    function isValidGroupTaskCreate(d) {
      return isValidGroupTaskFields(d)
          && d.claimedUids.size() == 0 && d.waitlistUids.size() == 0 && d.declinedUids.size() == 0
          && d.nextTaskId == null
          && d.doneAt == null && d.doneBy == null
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
    }
    // Ticking done stamps the server time and the ticker; undoing clears both.
    function isGroupTaskDoneTick(n) {
      return (n.doneAt == request.time && n.doneBy == request.auth.uid)
          || (n.doneAt == null && n.doneBy == null);
    }
    function isValidGroupTaskUpdate(n, o) {
      return isValidGroupTaskFields(n)
          && !n.diff(o).affectedKeys().hasAny(['claimedUids', 'waitlistUids', 'declinedUids', 'nextTaskId', 'createdBy', 'createdAt'])
          && ((n.doneAt == o.doneAt && n.doneBy == o.doneBy) || isGroupTaskDoneTick(n))
          // A shift keeps room for the people already in it.
          && (n.slots == null
            ? (o.claimedUids.size() == 0 && o.waitlistUids.size() == 0)
            : n.slots >= o.claimedUids.size());
    }
    function isValidTaskTemplate(d) {
      return d.keys().hasOnly(['name', 'items', 'updatedBy', 'updatedAt'])
          && d.keys().hasAll(['name', 'items', 'updatedBy', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 50
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
    }

    // ── Records (actas, ledgerEntries) ──────────────────────────────────────
    // See RecordsDataModel. Only orgs with a socio roster keep them.
    function actaKeys() {
      return [
        'body', 'title', 'heldOn', 'place', 'attendees', 'otherAttendees', 'agenda', 'agreements',
        'visibleToSocios', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt',
      ];
    }
    // Every write stamps who last touched the acta and the server time.
    function isValidActaFields(d) {
      return d.keys().hasOnly(actaKeys())
          && d.keys().hasAll(actaKeys())
          && d.body in ['asamblea_general', 'junta_directiva', 'otro']
          && isNullOrShortString(d.title, 120)
          && isDayKey(d.heldOn)
          && isNullOrShortString(d.place, 200)
          && d.attendees is list && d.attendees.size() <= 500
          && d.otherAttendees is int && d.otherAttendees >= 0 && d.otherAttendees <= 10000
          && d.agenda is list && d.agenda.size() <= 50
          && d.agreements is list && d.agreements.size() <= 50
          && d.visibleToSocios is bool
          && d.updatedBy == request.auth.uid
          && d.updatedAt == request.time;
    }
    function isValidActaCreate(d) {
      return isValidActaFields(d)
          && d.createdBy == request.auth.uid
          && d.createdAt == request.time;
    }
    function isValidLedgerEntry(d) {
      return d.keys().hasOnly(['kind', 'amountCents', 'on', 'concept', 'category', 'reversesId', 'recordedBy', 'recordedAt'])
          && d.keys().hasAll(['kind', 'amountCents', 'on', 'concept', 'category', 'reversesId', 'recordedBy', 'recordedAt'])
          && d.kind in ['income', 'expense']
          && d.amountCents is int && d.amountCents >= 1 && d.amountCents <= 100000000
          && isDayKey(d.on)
          && d.concept is string && d.concept.size() >= 1 && d.concept.size() <= 200
          && isNullOrShortString(d.category, 60)
          && (d.reversesId == null || d.reversesId is string)
          && d.recordedBy == request.auth.uid
          && d.recordedAt == request.time;
    }

    function isValidSocioPrivate(d) {
      return d.keys().hasOnly(['phone', 'email', 'consentAnsweredAt'])
          && d.keys().hasAll(['phone', 'email', 'consentAnsweredAt'])
          && (d.phone == null || (d.phone is string && d.phone.size() <= 40))
          && (d.email == null || (d.email is string && d.email.size() <= 200))
          && isTimestampOrNull(d.consentAnsweredAt);
    }

    function isValidPlaceCreate(d) {
      return d.keys().hasOnly([
              'name', 'kind', 'description', 'municipalityId', 'coordinates', 'locationLabel', 'images',
              'createdAt', 'status', 'proposedBy', 'contributorUserIds', 'contributorOrgIds', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount', 'burialCount',
            ])
          && d.keys().hasAll([
              'name', 'kind', 'description', 'municipalityId', 'coordinates', 'locationLabel', 'images',
              'createdAt', 'status', 'proposedBy', 'contributorUserIds', 'contributorOrgIds', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount', 'burialCount',
            ])
          && isString(d.name)
          && d.kind in ['cemetery', 'church', 'hermitage', 'plaza', 'town_hall', 'otros']
          && isStringOrNull(d.description)
          && isString(d.municipalityId)
          && isLatLngOrNull(d.coordinates)
          // A label is only meaningful next to a pin: without one there is no
          // map and no directions, just an orphan string on the detail screen.
          && isStringOrNull(d.locationLabel)
          && (d.coordinates != null || d.locationLabel == null)
          && isList(d.images) && d.images.size() <= 5
          && isTimestamp(d.createdAt)
          && d.status == 'active'
          && isStringOrNull(d.proposedBy)
          && isList(d.contributorUserIds)
          && isList(d.contributorOrgIds)
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          && d.commentCount == 0
          && d.readCount == 0
          && d.burialCount == 0;
    }

    function isValidFestivalPosterCreate(d) {
      return d.keys().hasOnly([
              'municipalityId', 'villageSlug', 'proposedBy', 'contributorUserIds', 'contributorOrgIds', 'year', 'title', 'images',
              'datePrecision', 'startsAt', 'endsAt', 'createdAt',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount',
            ])
          && d.keys().hasAll([
              'municipalityId', 'villageSlug', 'proposedBy', 'contributorUserIds', 'contributorOrgIds', 'year', 'title', 'images',
              'datePrecision', 'startsAt', 'endsAt', 'createdAt',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount',
            ])
          && isString(d.municipalityId)
          && isString(d.villageSlug)
          && isStringOrNull(d.proposedBy)
          && isList(d.contributorUserIds)
          && isList(d.contributorOrgIds)
          && d.year is int
          && isStringOrNull(d.title)
          && isList(d.images) && d.images.size() <= 5
          && d.datePrecision in ['year', 'month', 'day']
          && isTimestampOrNull(d.startsAt)
          && isTimestampOrNull(d.endsAt)
          && isTimestamp(d.createdAt)
          && d.status == 'active'
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          && d.commentCount == 0
          && d.readCount == 0;
    }

    function isValidBarrioCreate(d) {
      return d.keys().hasOnly([
              'name', 'municipalityId', 'kind', 'source', 'isSeat', 'images', 'createdAt',
              'status', 'proposedBy', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount', 'residentCount',
            ])
          && d.keys().hasAll([
              'name', 'municipalityId', 'kind', 'source', 'isSeat', 'images', 'createdAt',
              'status', 'proposedBy', 'hiddenBy', 'hiddenAt', 'hiddenReason',
              'commentCount', 'readCount', 'residentCount',
            ])
          && isString(d.name)
          && isString(d.municipalityId)
          // A client may only ever create a neighbourhood. The settlement kinds
          // (pedania, aldea, parroquia) are reference data seeded from OSM by
          // the Admin SDK at village activation, which bypasses these rules —
          // so a user cannot invent a pedania, and cannot pass one off as the
          // municipal seat.
          && d.kind == 'barrio'
          && d.source == 'user'
          && d.isSeat == false
          && isList(d.images) && d.images.size() <= 5
          && isTimestamp(d.createdAt)
          && d.status == 'active'
          && isStringOrNull(d.proposedBy)
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          && d.commentCount == 0
          && d.readCount == 0
          && d.residentCount == 0;
    }

    // Once an event has sign-ups, its signupFields list is additive-only: the
    // answers already collected are keyed by the existing field ids, so
    // dropping or reordering a field strands them against the wrong spec.
    //
    // Rules have no loops, so only the size half of that invariant is
    // expressible here; "entry i keeps its id and type" is enforced by
    // isAdditiveSignupFieldChange in SignupFieldModel, applied by the edit
    // form. That gap is deliberate and bounded: event update is already
    // organizer-gated, so the only actor who can violate it is the organizer,
    // and the only data harmed is the answers on their own event.
    function isAdditiveSignupFieldsChange(before, after) {
      return before.get('totalCount', 0) == 0
          || after.get('signupFields', []).size() >= before.get('signupFields', []).size();
    }

    // Group size is frozen the moment anyone signs up. Seats already booked
    // were sized and seated against the old value, so lowering it would strand
    // over-sized groups and raising it would leave existing ones short — and
    // neither the client nor rules can re-seat them.
    function isFrozenGroupSizeChange(before, after) {
      return before.get('totalCount', 0) == 0
          || after.get('signupGroupSize', 1) == before.get('signupGroupSize', 1);
    }

    // One occurrence of a weekly or monthly series (EventSeriesModel). Rules
    // cannot iterate, so the weekday list is checked by membership and size;
    // the 183-day cap mirrors MAX_SERIES_DAYS and the 366-day one
    // MAX_MONTHLY_SERIES_DAYS (one day of slack, since `until` is a calendar
    // day and the occurrence a time on it). Keep them in step. `frequency` is
    // optional: binaries that predate monthly series never send it.
    function isValidEventSeries(d, s) {
      return s == null || (
        s is map
          && s.keys().hasOnly(['id', 'index', 'frequency', 'weekdays', 'until'])
          && s.get('frequency', 'weekly') in ['weekly', 'monthly']
          && s.keys().hasAll(['id', 'index', 'weekdays', 'until'])
          && isString(s.id) && s.id.size() > 0
          && s.index is int && s.index >= 0 && s.index <= 200
          && s.weekdays is list && s.weekdays.size() >= 1 && s.weekdays.size() <= 7
          && s.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
          && isTimestamp(s.until)
          // `until` is the start of the last calendar day, and a Madrid day
          // runs 25 hours on the night clocks go back — 25 h keeps a late
          // occurrence on that day valid (and lets nothing past 01:00 after it).
          && d.startDate < s.until + duration.value(25, 'h')
          && s.until < d.startDate + duration.value(s.get('frequency', 'weekly') == 'monthly' ? 367 : 184, 'd')
      );
    }

    // A yearly event is one edition, never a series. Optional: binaries that
    // predate it never send the field.
    function isValidRepeatsYearly(d) {
      return d.get('repeatsYearly', false) is bool
        && (d.get('repeatsYearly', false) == false || d.get('series', null) == null);
    }

    // Who may put an occurrence into a series. The first occurrence (index 0)
    // IS the series: its id is the series id, so nobody can claim an id
    // already taken. Every later one must point at a root that exists once the
    // request lands (`getAfter`: the whole series is one batch), made by the
    // same creator in the same village, with the same visibility. Without this
    // any member could slot an earlier-dated "occurrence" into someone else's
    // series — replacing its card in every collapsed list — or a later one that
    // makes the organizer's "este y los siguientes" batch fail.
    function isOwnSeriesOccurrence(eventId, d) {
      let s = d.get('series', null);
      return s == null
        || (s.index == 0 && s.id == eventId)
        || (s.index > 0 && s.id != eventId && isOwnSeriesRoot(s.id, d));
    }

    function isOwnSeriesRoot(rootId, d) {
      let path = /databases/$(database)/documents/events/$(rootId);
      return existsAfter(path) && isSeriesRootOf(getAfter(path).data, rootId, d);
    }

    function isSeriesRootOf(root, rootId, d) {
      let rs = root.get('series', null);
      return rs != null
        && rs.id == rootId
        && rs.index == 0
        && root.createdBy == d.createdBy
        && root.municipalityId == d.municipalityId
        && root.visibilityOrgId == d.visibilityOrgId
        // The rule is the root's: a sliding `until` would let a series grow
        // past MAX_SERIES_DAYS one hop at a time.
        && rs.until == d.series.until
        && rs.get('frequency', 'weekly') == d.series.get('frequency', 'weekly')
        && rs.weekdays == d.series.weekdays;
    }

    function isValidEventCreate(d) {
      return d.keys().hasOnly([
              'title', 'description', 'startDate', 'endDate', 'endBoundary', 'location',
              'imageURL', 'maxAttendees', 'telephoneRequired', 'requiresPayment',
              'signupFields', 'signupEnabled', 'signupInfo', 'attendeesVisibility', 'signupGroupSize',
              'minBirthYear', 'maxBirthYear',
              'visibility', 'visibilityOrgId', 'series', 'repeatsYearly',
              'status', 'organizerUserIds', 'organizerOrgIds', 'createdBy',
              'createdAt', 'updatedAt', 'municipalityId', 'villageName', 'villageSlug',
              'villageCoverImage', 'villageCoordinates',
              'confirmedCount', 'totalCount',
              'commentCount', 'readCount',
            ])
          && d.keys().hasAll([
              'title', 'description', 'startDate', 'endDate', 'endBoundary', 'location',
              'imageURL', 'maxAttendees', 'telephoneRequired', 'requiresPayment',
              'signupFields', 'signupEnabled', 'signupInfo', 'attendeesVisibility', 'signupGroupSize',
              'minBirthYear', 'maxBirthYear',
              'visibility', 'visibilityOrgId',
              'status', 'organizerUserIds', 'organizerOrgIds', 'createdBy',
              'createdAt', 'updatedAt', 'municipalityId', 'villageName', 'villageSlug',
              'villageCoverImage', 'villageCoordinates',
              'commentCount', 'readCount',
            ])
          && isString(d.title)
          && isString(d.description)
          && isTimestamp(d.startDate)
          // endDate is optional-but-present: null for single-day events,
          // otherwise a Timestamp no earlier than startDate.
          && isTimestampOrNull(d.endDate)
          && (d.endDate == null || d.endDate >= d.startDate)
          // endBoundary is the derived feed key: it must equal endDate ?? startDate
          // so the client can't corrupt Explora's ordering (see EventDataModel).
          && isTimestamp(d.endBoundary)
          && d.endBoundary == (d.endDate == null ? d.startDate : d.endDate)
          && isMap(d.location)
          && isStringOrNull(d.imageURL)
          && isNumberOrNull(d.maxAttendees)
          && isBool(d.telephoneRequired)
          && isBool(d.requiresPayment)
          // Creator-defined sign-up questions. Rules can check the container
          // (a list, within the cap that SignupFieldModel also enforces); the
          // per-entry shape is validated by the strict Zod converter on read
          // and by the create form on write.
          && d.signupFields is list
          && d.signupFields.size() <= 10
          // False = the event takes no in-app sign-ups; signupInfo is the
          // organizer's free-text alternative shown in the button's place.
          && isBool(d.signupEnabled)
          && isStringOrNull(d.signupInfo)
          && (d.signupInfo == null || d.signupInfo.size() <= 200)
          // Who may read this event's roster. Not world-readable by design —
          // see AttendeesVisibilitySchema and the registrations read rule.
          && d.attendeesVisibility in ['members', 'organizers']
          // How many people sign up together. Capped here as well as in
          // MAX_SIGNUP_GROUP_SIZE — groups are seated atomically, so an
          // unbounded size would make a capped event unfillable.
          && d.signupGroupSize is int
          && d.signupGroupSize >= 1
          && d.signupGroupSize <= 4
          // Advertised birth-year window. Advisory only — the sign-up sheet
          // warns and lets the user proceed — so rules check the shape, not
          // the eligibility of anyone signing up. Bounds mirror
          // MIN/MAX_EVENT_BIRTH_YEAR in EventFormSchema; keep the two in step.
          && isNumberOrNull(d.minBirthYear)
          && isNumberOrNull(d.maxBirthYear)
          && (d.minBirthYear == null || (d.minBirthYear is int && d.minBirthYear >= 1900 && d.minBirthYear <= 2200))
          && (d.maxBirthYear == null || (d.maxBirthYear is int && d.maxBirthYear >= 1900 && d.maxBirthYear <= 2200))
          && (d.minBirthYear == null || d.maxBirthYear == null || d.maxBirthYear >= d.minBirthYear)
          // Private events. The enum and the org pointer are one fact stored
          // twice (the enum is what feeds can filter on, the id is what the
          // read rule resolves), so they must agree or the event becomes
          // either invisible to everyone or visible to the wrong people.
          && d.visibility in ['public', 'organization']
          && isStringOrNull(d.visibilityOrgId)
          && (d.visibility == 'organization') == (d.visibilityOrgId != null)
          // Optional, not in hasAll: binaries that predate weekly series never
          // send it, and their creates must keep working.
          && isValidEventSeries(d, d.get('series', null))
          && isValidRepeatsYearly(d)
          && d.status in ['published', 'cancelled', 'completed']
          && d.organizerUserIds is list
          && d.organizerOrgIds is list
          && isString(d.createdBy)
          && isTimestamp(d.createdAt)
          && isTimestamp(d.updatedAt)
          && isString(d.municipalityId)
          && isString(d.villageName)
          && isString(d.villageSlug)
          && isStringOrNull(d.villageCoverImage)
          && isLatLngOrNull(d.villageCoordinates)
          && d.commentCount == 0
          && d.readCount == 0;
    }

    function isValidEntityKind(v) {
      return v in ['event', 'festivalPoster', 'place', 'barrio', 'organization', 'news', 'vocabularyTerm', 'historyEntry'];
    }

    function isValidCommentCreate(d) {
      return d.keys().hasOnly(['entityKind', 'entityId', 'municipalityId', 'authorUserId', 'body', 'createdAt', 'parentCommentId', 'replyCount'])
          && d.keys().hasAll(['entityKind', 'entityId', 'municipalityId', 'authorUserId', 'body', 'createdAt', 'parentCommentId', 'replyCount'])
          && isValidEntityKind(d.entityKind)
          && isString(d.entityId)
          && isString(d.municipalityId)
          && isString(d.authorUserId)
          && isString(d.body) && d.body.size() > 0 && d.body.size() <= 2000
          && isTimestamp(d.createdAt)
          && (d.parentCommentId == null || isString(d.parentCommentId))
          && d.replyCount == 0
          && commentTargetsClaimedVillage(d.entityKind, d.entityId, d.municipalityId)
          && (d.parentCommentId == null || isValidReplyParent(d.entityKind, d.entityId, d.municipalityId, d.parentCommentId));
    }

    function isValidContentReportCreate(d) {
      return d.keys().hasOnly(['municipalityId', 'targetKind', 'targetId', 'targetAuthorUserId', 'reporterUserId', 'reason', 'note', 'status', 'createdAt'])
          && d.keys().hasAll(['municipalityId', 'targetKind', 'targetId', 'targetAuthorUserId', 'reporterUserId', 'reason', 'note', 'status', 'createdAt'])
          && isString(d.municipalityId)
          && d.targetKind in ['event', 'festivalPoster', 'place', 'barrio', 'organization', 'news', 'vocabularyTerm', 'historyEntry', 'comment', 'person']
          && isString(d.targetId)
          && isStringOrNull(d.targetAuthorUserId)
          && isString(d.reporterUserId)
          && d.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'falseInfo', 'other']
          && (d.note == null || (isString(d.note) && d.note.size() <= 500))
          && d.status == 'open'
          && isTimestamp(d.createdAt);
    }

    // Digitization credit (ContributorsModel). Credit, never authority — so the
    // only things worth enforcing are that the author cannot write themselves
    // out of their own contribution, and that a list cannot grow unbounded.
    // The cap is a spam brake, not a product limit: nobody digitalizes one word
    // with twenty-one people, but a script could name the whole village.
    function isValidDigitizationCredit(d) {
      return isList(d.contributorUserIds)
          && isList(d.contributorOrgIds)
          && d.contributorUserIds.size() <= 20
          && d.contributorOrgIds.size() <= 20
          && d.createdBy in d.contributorUserIds;
    }

    // A term's doc id is derived (municipalityId + slug), so the create rule
    // must pin the claimed municipalityId to the path — otherwise a member of
    // pueblo A could seed `B__esbardo` and own B's headword.
    function isValidVocabularyTermCreate(d, termId) {
      return d.keys().hasOnly([
              'municipalityId', 'term', 'normalized', 'kind', 'createdBy', 'createdAt',
              'contributorUserIds', 'contributorOrgIds',
              'definitionCount', 'commentCount', 'readCount',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && d.keys().hasAll([
              'municipalityId', 'term', 'normalized', 'kind', 'createdBy', 'createdAt',
              'contributorUserIds', 'contributorOrgIds',
              'definitionCount', 'commentCount', 'readCount',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && isString(d.municipalityId)
          && isString(d.term) && d.term.size() > 0 && d.term.size() <= 80
          && isString(d.normalized) && d.normalized.size() > 0 && d.normalized.size() <= 80
          && d.kind in ['palabra', 'dicho', 'mote', 'toponimo']
          && isString(d.createdBy)
          && isValidDigitizationCredit(d)
          && isTimestamp(d.createdAt)
          && d.definitionCount == 0
          && d.commentCount == 0
          && d.readCount == 0
          && d.status == 'active'
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          && termId == d.municipalityId + '__' + d.normalized;
    }

    function isValidVocabularyDefinitionCreate(d) {
      return d.keys().hasOnly([
              'municipalityId', 'termId', 'definition', 'example', 'castellano',
              'createdBy', 'contributorUserIds', 'contributorOrgIds', 'createdAt', 'updatedAt',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && d.keys().hasAll([
              'municipalityId', 'termId', 'definition', 'example', 'castellano',
              'createdBy', 'contributorUserIds', 'contributorOrgIds', 'createdAt', 'updatedAt',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && isString(d.municipalityId)
          && isString(d.termId)
          && isString(d.definition) && d.definition.size() > 0 && d.definition.size() <= 1000
          && (d.example == null || (isString(d.example) && d.example.size() <= 500))
          && (d.castellano == null || (isString(d.castellano) && d.castellano.size() <= 200))
          && isString(d.createdBy)
          && isValidDigitizationCredit(d)
          && isTimestamp(d.createdAt)
          && isTimestamp(d.updatedAt)
          && d.status == 'active'
          && d.hiddenBy == null
          && d.hiddenAt == null
          && d.hiddenReason == null
          // Same anchoring as a comment: the definition's municipalityId is what
          // its own delete rule reads for admin authority, so it must match the
          // term it claims to define.
          && topLevelEntityInVillage(/databases/$(database)/documents/vocabularyTerms/$(d.termId), d.municipalityId);
    }

    // ── Village history ──────────────────────────────────────────────────
    // A historical date is plain integers, not a timestamp, so it can hold a
    // BC year. `sortKey` is what the timeline orders on; it is re-derived here
    // (same arithmetic as `historicalDateSortKey`) so a client cannot file an
    // entry at a date it does not claim.
    function isValidHistoricalDate(v) {
      return isMap(v)
          && v.keys().hasOnly(['year', 'month', 'day'])
          && v.keys().hasAll(['year', 'month', 'day'])
          && v.year is int && v.year >= -9999 && v.year <= 9999 && v.year != 0
          && (v.month == null || (v.month is int && v.month >= 1 && v.month <= 12))
          && (v.day == null || (v.month != null && v.day is int && v.day >= 1 && v.day <= 31));
    }

    function historicalDateSortKey(v) {
      return v.year * 10000
           + (v.month == null ? 0 : v.month * 100)
           + (v.day == null ? 0 : v.day);
    }

    function isValidHistoryEntryShape(d) {
      return d.keys().hasOnly([
              'municipalityId', 'villageSlug', 'createdBy', 'title', 'body', 'images', 'start', 'end',
              'approximate', 'sources', 'sortKey', 'createdAt', 'updatedAt',
              'commentCount', 'readCount',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && d.keys().hasAll([
              'municipalityId', 'villageSlug', 'createdBy', 'title', 'body', 'images', 'start', 'end',
              'approximate', 'sources', 'sortKey', 'createdAt', 'updatedAt',
              'commentCount', 'readCount',
              'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
            ])
          && isString(d.municipalityId)
          && isString(d.villageSlug)
          && isString(d.createdBy)
          && isString(d.title) && d.title.size() > 0 && d.title.size() <= 120
          && isMap(d.body)
          && d.body.keys().hasOnly(['text', 'mentions', 'links', 'marks'])
          && isString(d.body.text) && d.body.text.size() <= 20000
          && isList(d.body.mentions) && isList(d.body.links) && isList(d.body.marks)
          && isList(d.images) && d.images.size() <= 3
          && isValidHistoricalDate(d.start)
          && (d.end == null
              || (isValidHistoricalDate(d.end) && historicalDateSortKey(d.end) > historicalDateSortKey(d.start)))
          && isBool(d.approximate)
          && (d.sources == null || (isString(d.sources) && d.sources.size() <= 2000))
          && d.sortKey == historicalDateSortKey(d.start)
          && isTimestamp(d.createdAt)
          && isTimestamp(d.updatedAt);
    }

    // The platform decides the transport: an Android token is an FCM token,
    // an iOS token is a raw APNs token that must carry its gateway and bundle
    // id (see DeviceTokenDataModel). The pairing is asserted here as well as in
    // the converter so a malformed row can never reach a transport.
    function isValidDeviceTokenWrite(d, token) {
      let keys = ['token', 'platform', 'apnsEnvironment', 'apnsTopic', 'appVersion', 'createdAt', 'lastSeenAt'];
      return d.keys().hasOnly(keys)
          && d.keys().hasAll(keys)
          && d.token == token
          && d.appVersion is string
          && isTimestamp(d.createdAt)
          && isTimestamp(d.lastSeenAt)
          && (
               (d.platform == 'android'
                 && d.apnsEnvironment == null
                 && d.apnsTopic == null)
            || (d.platform == 'ios'
                 && d.apnsEnvironment in ['production', 'sandbox']
                 && d.apnsTopic is string
                 && d.apnsTopic.size() > 0)
          );
    }

    function isValidNotificationPrefsWrite(d) {
      return d.keys().hasOnly(['mine', 'village', 'social', 'quietHours', 'updatedAt'])
          && d.keys().hasAll(['mine', 'village', 'social', 'quietHours', 'updatedAt'])
          && d.mine is bool
          && d.village is bool
          && d.social is bool
          && d.quietHours is bool
          && isTimestamp(d.updatedAt);
    }

    function isValidBlockedUserCreate(d, blockedUserId) {
      return d.keys().hasOnly(['blockedUserId', 'createdAt'])
          && d.keys().hasAll(['blockedUserId', 'createdAt'])
          && d.blockedUserId == blockedUserId
          && isTimestamp(d.createdAt);
    }

    function isValidReplyParent(entityKind, entityId, municipalityId, parentCommentId) {
      let parent = get(/databases/$(database)/documents/comments/$(parentCommentId));
      return parent.data.entityKind == entityKind
          && parent.data.entityId == entityId
          && parent.data.municipalityId == municipalityId
          && parent.data.parentCommentId == null;
    }

    // Activating the community (null -> object) is startVillage's job, so a
    // client may only carry an unchanged organizer pointer through an update.
    // Read every hop with get(k, null): a community map predating the
    // organizer pointer has no such key, and a bare `.organizerId` on it is an
    // evaluation error, which denies the write outright — locking admins out
    // of editing their own pueblo rather than merely pinning the pointer.
    // `organizerSex` rides with the pointer: it is the Embajador's own
    // denormalized sex, owned by the functions that move the pointer.
    function organizerIdUnchanged(before, after) {
      return (before.get('community', null) == null && after.get('community', null) == null)
          || (before.get('community', null) != null && after.get('community', null) != null
              && before.community.get('organizerId', null)
                 == after.community.get('organizerId', null)
              && before.community.get('organizerSex', null)
                 == after.community.get('organizerSex', null));
    }

    // A comment carries the municipalityId that its own delete rule reads for
    // village-admin authority, so an unchecked value lets an author put their
    // comment outside the reach of the moderators who own the entity. Anchor
    // it to the target: nested kinds must exist under the claimed
    // municipality, top-level kinds must agree with the stored field.
    function commentTargetsClaimedVillage(kind, id, mid) {
      return kind == 'place'
               ? exists(/databases/$(database)/documents/municipalities/$(mid)/places/$(id))
           : kind == 'barrio'
               ? exists(/databases/$(database)/documents/municipalities/$(mid)/barrios/$(id))
           : kind == 'event'
               ? topLevelEntityInVillage(/databases/$(database)/documents/events/$(id), mid)
           : kind == 'news'
               ? topLevelEntityInVillage(/databases/$(database)/documents/news/$(id), mid)
           : kind == 'organization'
               ? topLevelEntityInVillage(/databases/$(database)/documents/organizations/$(id), mid)
           : kind == 'festivalPoster'
               ? topLevelEntityInVillage(/databases/$(database)/documents/festivalPosters/$(id), mid)
           : kind == 'vocabularyTerm'
               ? topLevelEntityInVillage(/databases/$(database)/documents/vocabularyTerms/$(id), mid)
           : kind == 'historyEntry'
               ? topLevelEntityInVillage(/databases/$(database)/documents/historyEntries/$(id), mid)
           : false;
    }

    function topLevelEntityInVillage(path, mid) {
      return exists(path) && get(path).data.municipalityId == mid;
    }

    // ── Collections ──────────────────────────────────────────────────────

    match /news/{postId} {
      // Active posts are public (parity with published events) so the
      // cross-village Explora feed can list them. Hidden posts stay visible
      // only to members of the post's own village (moderation + author).
      allow read: if resource.data.status == 'active'
                    || isVillageMember(resource.data.municipalityId)
                    || isOwner(resource.data.createdBy)
                    || (request.auth.uid in resource.data.organizerUserIds);
      allow create: if isVillageMember(request.resource.data.municipalityId)
                      && isValidNewsPostCreate(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid
                      && (request.auth.uid in request.resource.data.organizerUserIds)
                      && request.resource.data.readCount == 0
                      && request.resource.data.commentCount == 0;
      // status/hiddenBy/hiddenAt/hiddenReason are function-owned — clients
      // can never touch them; setContentVisibility (Cloud Function) is the
      // only writer. Posts are created `active` (optimistic; enforced by
      // isValidNewsPostCreate), never gated behind a pending/approved queue.
      // Authority is the CURRENT organizer set (resource.data, pre-update), so a
      // named organizer may reattribute the post. organizerUserIds/OrgIds are
      // editable but must stay non-empty — an empty set would orphan the article
      // (only the immutable createdBy owner + admins could then reach it).
      // Same three identities every other entity kind accepts: author, named
      // organizer, or an admin of the article's pueblo.
      allow update: if (
                        isOwner(resource.data.createdBy)
                        || (request.auth.uid in resource.data.organizerUserIds)
                        || isVillageAdmin(resource.data.municipalityId)
                        || isAppAdmin()
                      )
                      && request.resource.data.organizerUserIds.size() > 0
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                           'status','hiddenBy','hiddenAt','hiddenReason',
                           'publishedAt',
                           'municipalityId','villageSlug','createdAt','createdBy',
                           'readCount','commentCount'
                         ]);
      // Clients never delete a post directly — the deleteNewsPost callable
      // cascades comments with the admin SDK (author or admin).
      allow delete: if false;
    }

    // ── Vocabulary: a pueblo's own words ────────────────────────────────
    // Members write, everyone reads — a word from a pueblo you don't live in is
    // exactly the thing worth not losing, so the read side joins the open feed.
    match /vocabularyTerms/{termId} {
      // `resource == null` FIRST, and it is load-bearing rather than defensive.
      // A term's id is derived from the word, so adding one begins by reading
      // the id that does not exist yet (ensureVocabularyTerm) — a blind setDoc
      // onto a word somebody already added would be an *update* in rules terms
      // and is denied. Without this clause that probe dereferences a null
      // `resource`, the rule errors, and Firestore reports it as
      // permission-denied: adding any new word fails before it starts. It also
      // makes a share link to a deleted term a plain "not found" instead of an
      // error.
      allow read: if resource == null
                    || resource.data.status == 'active'
                    || isVillageMember(resource.data.municipalityId)
                    || isOwner(resource.data.createdBy);
      allow create: if isVillageMember(request.resource.data.municipalityId)
                      && isValidVocabularyTermCreate(request.resource.data, termId)
                      && request.resource.data.createdBy == request.auth.uid;
      // Nothing on a term is client-editable. `term`/`normalized`/`kind` fix the
      // identity the doc id is derived from; the counters and the visibility
      // fields are function-owned. Correcting a headword means adding the right
      // one and letting the wrong one be deleted — which keeps the derived id
      // and the stored word from ever disagreeing.
      allow update: if false;
      // A term with definitions still on it must not vanish under them; once the
      // last one is gone the author may withdraw the empty headword. Admins are
      // not bound by that — an abusive term should go immediately.
      allow delete: if isVillageAdmin(resource.data.municipalityId)
                      || isAppAdmin()
                      || (isOwner(resource.data.createdBy)
                          && resource.data.status == 'active'
                          && resource.data.definitionCount == 0);
    }

    // The shared word index: one row per word across every village, derived
    // from the entries below by syncVocabularyWordIndex. Public so the "añadir
    // palabra" search works for anyone, and function-owned — a client write
    // here would let one villager restyle a word's spelling for every pueblo,
    // or invent a word no village records.
    match /vocabularyWords/{slug} {
      allow read: if true;
      allow write: if false;
    }

    match /vocabularyDefinitions/{definitionId} {
      // Same null-resource guard as vocabularyTerms above: a missing definition
      // must read as "not found", not as denied.
      allow read: if resource == null
                    || resource.data.status == 'active'
                    || isVillageMember(resource.data.municipalityId)
                    || isOwner(resource.data.createdBy);
      allow create: if isVillageMember(request.resource.data.municipalityId)
                      && isValidVocabularyDefinitionCreate(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid;
      // Only the author edits their own meaning — a village admin's lever is
      // hide (setContentVisibility) or delete, never rewriting what someone else
      // said a word means.
      allow update: if isOwner(resource.data.createdBy)
                      && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                           'municipalityId', 'termId', 'createdBy', 'createdAt',
                           'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
                         ])
                      // Re-crediting is an ordinary author edit, held to the
                      // same credit rules as the create.
                      && isValidDigitizationCredit(request.resource.data);
      allow delete: if isOwner(resource.data.createdBy)
                      || isVillageAdmin(resource.data.municipalityId)
                      || isAppAdmin();
    }

    // ── Village history: a pueblo's timeline ─────────────────────────────
    // Members write, everyone reads, admins moderate after the fact — the same
    // open posture as vocabulary. Admins may also correct someone else's entry
    // (unlike a vocabulary definition, an entry is a shared account of an event,
    // not one villager's opinion).
    match /historyEntries/{entryId} {
      allow read: if resource.data.status == 'active'
                    || isVillageMember(resource.data.municipalityId)
                    || isOwner(resource.data.createdBy);
      allow create: if isVillageMember(request.resource.data.municipalityId)
                      && isValidHistoryEntryShape(request.resource.data)
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.commentCount == 0
                      && request.resource.data.readCount == 0
                      && request.resource.data.status == 'active'
                      && request.resource.data.hiddenBy == null
                      && request.resource.data.hiddenAt == null
                      && request.resource.data.hiddenReason == null;
      // Authority reads the STORED municipalityId, and the diff below keeps it
      // immutable — otherwise an admin of pueblo A could walk an entry into B.
      // Counters and visibility are function-owned.
      allow update: if (
                        isOwner(resource.data.createdBy)
                        || isVillageAdmin(resource.data.municipalityId)
                        || isAppAdmin()
                      )
                      && isValidHistoryEntryShape(request.resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           'title', 'body', 'images', 'start', 'end', 'approximate',
                           'sources', 'sortKey', 'updatedAt',
                         ]);
      allow delete: if isVillageAdmin(resource.data.municipalityId)
                      || isAppAdmin()
                      || (isOwner(resource.data.createdBy) && resource.data.status == 'active');
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated()
                      && isValidCommentCreate(request.resource.data)
                      && request.resource.data.authorUserId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.authorUserId)
                      || isVillageAdmin(resource.data.municipalityId)
                      || isAppAdmin();
    }

    match /admins/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      allow write: if false;
    }

    // The account doc holds private contact fields (email, telephone). What
    // other people may see of an account is projected to publicProfiles/{uid}.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAppAdmin();
      // displayName is denormalized from persons/{id} by the
      // syncPersonDenormalization Cloud Function — clients must not touch it.
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['displayName'])
                    && isValidUserCreate(request.resource.data)
                    && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
                    && isEmailUpdateVerified(
                         request.resource.data,
                         request.resource.data.diff(resource.data).affectedKeys()
                       )
                    && (
                         isValidUserUpdateKeys(
                           request.resource.data.diff(resource.data).affectedKeys()
                         )
                         || isOnboardingUserMerge(request.resource.data, resource.data)
                       );
      allow delete: if false;

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }

      // Push registration tokens. THE DOCUMENT ID IS THE TOKEN, so a device
      // re-registering on every launch overwrites its own row instead of
      // accumulating one per session. Owner-only in both directions: the token
      // is what addresses a push at a person's pocket, and a readable list
      // would let anyone enumerate a user's devices.
      match /devices/{token} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidDeviceTokenWrite(request.resource.data, token);
      }

      // Push preferences. Optional by design — an account with no doc gets
      // DEFAULT_NOTIFICATION_PREFS — so there is no create/update split here.
      // These gate PUSH only; the in-app Buzón always receives everything, so
      // muting a category can never destroy the durable record.
      match /preferences/{prefId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && prefId == 'notifications'
          && isValidNotificationPrefsWrite(request.resource.data);
      }

      // One group's message pushes muted or not (GroupNotificationPrefsData).
      // Optional like the account's prefs; the doc id is the org.
      match /groupPrefs/{orgId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['messagesMuted', 'generalChatPush', 'updatedAt'])
          && request.resource.data.keys().hasAll(['messagesMuted', 'updatedAt'])
          && request.resource.data.messagesMuted is bool
          && request.resource.data.get('generalChatPush', false) is bool
          && isTimestamp(request.resource.data.updatedAt);
      }

      // Per-user block list. Owner-only in BOTH directions: a readable list
      // would disclose who blocked whom, which is itself harassment material.
      // The doc id is the blocked uid, so blocking twice is one doc.
      match /blockedUsers/{blockedUserId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && blockedUserId != userId
          && isValidBlockedUserCreate(request.resource.data, blockedUserId);
        allow update: if false;
      }
    }

    // Public projection of users/{uid}: only what other people may see of an
    // account. Function-owned (syncPublicProfile). Single-doc reads only — a
    // list would hand anyone a directory of every account.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list, write: if false;
    }

    // municipalities: reference data + optional community overlay.
    // Reference fields are superadmin-only; community fields are managed by
    // the village admin once activated. Shape is not enforced here because
    // these writes only happen via the seed script + village admin UI, both
    // of which go through the typed converter; adding hasOnly() here would
    // require updating every admin script.
    match /municipalities/{municipalityId} {
      allow read: if true;
      // Only superadmin can create the base municipality record (the seed
      // script runs with admin credentials).
      allow create: if isAppAdmin();
      // Updates: village admins can edit the community subfield + coordinates;
      // superadmin can edit anything; nobody else can write.
      //
      // The INE reference fields and `communityActive` are identity, not
      // content — a village admin editing their pueblo must not be able to
      // rewrite which municipality it *is*, nor deactivate the community
      // (that is startVillage's to own). `peopleCount` is a denormalized
      // counter owned by syncVillagePeopleCount.
      //
      // `community.organizerId` is diff-locked separately because
      // affectedKeys() only reports the top-level `community` key, and the
      // organizer pointer is granted solely by respondToOrganizerRequest.
      // Left writable, a village admin could self-appoint as founding
      // organizer, which changeVillageMemberRole then refuses to demote —
      // an irreversible admin lock.
      allow update: if isAppAdmin() || (
           isVillageAdmin(municipalityId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'name', 'nameLower', 'province', 'comunidadAutonoma', 'codigoINE',
             'createdAt', 'communityActive', 'peopleCount',
           ])
        && organizerIdUnchanged(resource.data, request.resource.data)
      );
      allow delete: if isAppAdmin();

      // Instant self-service: any village member may create a barrio, which
      // lands `active` immediately (no propose/approve ceremony). status/
      // hiddenBy/hiddenAt/hiddenReason are function-owned — only the
      // setContentVisibility Cloud Function may hide/unhide afterward.
      match /barrios/{barrioId} {
        allow read: if true;
        allow create: if isAppAdmin()
          || isVillageAdmin(municipalityId)
          || (
               isVillageMember(municipalityId)
               && isValidBarrioCreate(request.resource.data)
               && request.resource.data.proposedBy == request.auth.uid
             );
        allow update: if (isVillageAdmin(municipalityId) || isAppAdmin() || isOwner(resource.data.proposedBy))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'kind', 'source', 'isSeat',
               'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
               'commentCount', 'readCount', 'residentCount',
               'proposedBy',
             ]);
        allow delete: if isVillageAdmin(municipalityId) || isAppAdmin()
          || (isOwner(resource.data.proposedBy) && resource.data.status == 'active');
      }

      match /places/{placeId} {
        allow read: if true;
        allow create: if isAppAdmin()
          || isVillageAdmin(municipalityId)
          || (
               isVillageMember(municipalityId)
               && isValidPlaceCreate(request.resource.data)
               && request.resource.data.proposedBy == request.auth.uid
             );
        allow update: if (isVillageAdmin(municipalityId) || isAppAdmin() || isOwner(resource.data.proposedBy))
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
               'commentCount', 'readCount', 'burialCount',
               'proposedBy',
             ]);
        allow delete: if isVillageAdmin(municipalityId) || isAppAdmin()
          || (isOwner(resource.data.proposedBy) && resource.data.status == 'active');
      }

      match /members/{userId} {
        allow read: if true;
        // `role` is function-owned: EVERY client-created member is a plain
        // 'user'. Admins granting/removing admin (or seeding one on organizer
        // approval) go through the changeVillageMemberRole callable / admin SDK,
        // which audits the change. So the create paths are: a village/app admin
        // adding a plain member, or a self-service join (owner adds themselves).
        // Census answers live in censoAnswers/ (owner + admins only); the member
        // doc is world-readable, so its legacy `profileAnswers` stays empty.
        allow create: if request.resource.data.role == 'user'
                       && request.resource.data.get('profileAnswers', {}) == {}
                       && (
                            isVillageAdmin(municipalityId)
                            || isAppAdmin()
                            || (
                                 isOwner(userId)
                                 && isCommunityActive(municipalityId)
                                 && request.resource.data.userId == userId
                               )
                          );
        // Admins may edit member fields client-side EXCEPT role
        // (changeVillageMemberRole callable) — function-owned. Owners edit
        // only their profile.
        allow update: if (
                         (isVillageAdmin(municipalityId) || isAppAdmin())
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'profileAnswers'])
                       )
                       || (isOwner(userId)
                           && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['profileCompletedAt']));
        allow delete: if isVillageAdmin(municipalityId) || isAppAdmin() || isOwner(userId);
      }

      // Village invite tokens were retired with their admin screen; no client
      // path reads or writes them. Explicit so a broader rule can't reopen it.
      match /inviteTokens/{tokenId} {
        allow read, write: if false;
      }

    }

    // A villager's census answers (residency, household, minors, origin…).
    // Private: the villager, the village's admins and app admins. The doc id
    // is {municipalityId}_{userId}, so the owner's own get works before the
    // doc exists. A village-admin list must filter by municipalityId.
    match /censoAnswers/{docId} {
      allow get: if resource == null
                   ? isAuthenticated() && docId.matches('.*_' + request.auth.uid)
                   : isOwner(resource.data.userId)
                     || isVillageAdmin(resource.data.municipalityId)
                     || isAppAdmin();
      allow list: if isVillageAdmin(resource.data.municipalityId) || isAppAdmin();
      allow create, update: if isOwner(request.resource.data.userId)
                              && docId == request.resource.data.municipalityId + '_' + request.auth.uid
                              && isVillageMember(request.resource.data.municipalityId)
                              && isValidCensoAnswersWrite(request.resource.data)
                              && (resource == null || (
                                   resource.data.userId == request.resource.data.userId
                                   && resource.data.municipalityId == request.resource.data.municipalityId
                                 ));
      allow delete: if isOwner(resource.data.userId)
                    || isVillageAdmin(resource.data.municipalityId)
                    || isAppAdmin();
    }

    match /organizerRequests/{requestId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAppAdmin());
      // Cloud Functions (admin SDK) own create/update/delete.
      allow create, update, delete: if false;
    }

    // Append-only membership/role audit log (see docs decision
    // membership-roles-and-audit). Function-owned: written only by callables /
    // triggers via the admin SDK, so every client write is denied — and, since
    // there is no client write path, no shape predicate is needed. Reads are
    // scoped to the village's admins (by municipalityId); org-scoped events are
    // additionally readable by that org's admins. app admins see everything.
    // Note: only the by-municipalityId read is usable as a list query; the org
    // clause applies to single-doc reads (list queries can't be constrained by
    // the per-doc scopeId/scopeType).
    match /membershipEvents/{eventId} {
      allow read: if isVillageAdmin(resource.data.municipalityId)
        || (resource.data.scopeType == 'org' && isOrgAdmin(resource.data.scopeId))
        || isAppAdmin();
      allow create, update, delete: if false;
    }

    // Append-only content-moderation audit log (hide/unhide of news,
    // festivalPosters, barrios, places). Function-owned: written only by the
    // setContentVisibility callable via the admin SDK. Reads scoped to the
    // village's admins by municipalityId; app admins see everything.
    match /moderationEvents/{eventId} {
      allow read: if isVillageAdmin(resource.data.municipalityId) || isAppAdmin();
      allow write: if false;
    }

    // Would-be Embajadores who left a name and phone on the read site's
    // /embajadores form. Written only by the readSite function (admin SDK).
    // Personal data from people with no account: app admins only.
    match /ambassadorLeads/{leadId} {
      allow read: if isAppAdmin();
      allow write: if false;
    }

    // User-filed reports about UGC (comments, news, profiles, entities). Any
    // signed-in person may file one — a report that can fail is worse than no
    // report — but only against themselves as reporter, and always unreviewed:
    // `status` is the moderator's field, so the create rule pins it to 'open'.
    // Reads are moderator-only; a reporter cannot enumerate reports, which
    // keeps the reported person from learning who filed.
    match /contentReports/{reportId} {
      allow read: if isVillageAdmin(resource.data.municipalityId) || isAppAdmin();
      allow create: if isAuthenticated()
                      && request.resource.data.reporterUserId == request.auth.uid
                      && isValidContentReportCreate(request.resource.data);
      allow update: if (isVillageAdmin(resource.data.municipalityId) || isAppAdmin())
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                      && request.resource.data.status in ['open', 'reviewed', 'dismissed'];
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if true;
      // ayuntamiento is a singleton per village — created only via the
      // requestAyuntamiento callable (admin SDK), which enforces the cap in a
      // transaction. peña / asociación are unlimited and created client-side.
      allow create: if isAuthenticated()
        && (isVillageMember(request.resource.data.municipalityId) || isAppAdmin())
        && isValidOrganizationCreate(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.type != 'ayuntamiento';
      // Approval (status -> 'approved') is function-owned: the approveOrganization
      // callable flips the status AND seeds the founding admin + audits it in one
      // transaction. Clients may edit other fields or reject, never approve.
      // `type` moves only among the self-service kinds. The ayuntamiento is a
      // per-village singleton that only requestAyuntamiento may mint, so no
      // group may become one and it may become nothing else.
      // `municipalityId` is locked because this rule derives village-admin
      // authority from it: rewriting it moves the org into another pueblo and
      // out of its own admins' reach.
      allow update: if (isVillageAdmin(resource.data.municipalityId) || isAppAdmin() || isOrgAdmin(orgId))
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == 'rejected')
        // Every org admits its members. Nothing reads the field any more, but
        // installed binaries do: an org they see as `open` offers a join that
        // the member rule below refuses.
        && (request.resource.data.get('joinPolicy', 'approval') == 'approval'
            || request.resource.data.get('joinPolicy', 'approval') == resource.data.get('joinPolicy', 'approval'))
        && request.resource.data.get('sociosListVisible', false) is bool
        && request.resource.data.get('chatAdminsOnly', false) is bool
        && (request.resource.data.type == resource.data.type
            || (resource.data.type in ['peña', 'asociación', 'otros']
                && request.resource.data.type in ['peña', 'asociación', 'otros']))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'commentCount', 'readCount', 'memberCount', 'followerCount',
             'municipalityId', 'villageSlug', 'requestedBy', 'createdAt',
           ]);
      allow delete: if isVillageAdmin(resource.data.municipalityId) || isAppAdmin();

      match /members/{userId} {
        allow read: if true;
        // `role` is function-owned: every client-created member is a plain
        // 'member'. Nobody adds themselves: membership is what admits someone to
        // private events and the libro de socios, so it is always an admin's
        // call — a direct add here, or a join request resolved by
        // respondToOrgJoinRequest. The founding admin is seeded server-side by
        // approveOrganization, and promotions go through the changeOrgMemberRole
        // callable — both audited via admin SDK.
        allow create: if isValidOrgMemberCreate(request.resource.data)
          && request.resource.data.userId == userId
          && request.resource.data.role == 'member'
          && (
               isOrgAdmin(orgId)
               || isVillageAdmin(orgMunicipalityId(orgId))
               || isAppAdmin()
             );
        // role goes through changeOrgMemberRole (admin SDK); a member doc has no
        // other client-editable fields.
        allow update: if false;
        allow delete: if isOwner(userId)
          || isOrgAdmin(orgId)
          || isVillageAdmin(orgMunicipalityId(orgId))
          || isAppAdmin();
      }

      // The socio roster — the libro de socios. Member rows are function-owned
      // (syncOrgSocioRoster: alta on join, baja on leave; linkSocioToMember
      // merges a typed row into one). A member adds and gives the baja to their
      // own personas a cargo; an admin types in socios without an account. No
      // row is ever deleted: leaving is a baja. Contact data is NOT here — see
      // socioPrivate — so a socio may read names when the estatutos allow it.
      match /socios/{socioId} {
        allow read: if isOrgAdmin(orgId)
          || (isAuthenticated()
              && (resource.data.uid == request.auth.uid
                  || resource.data.responsibleUid == request.auth.uid))
          || (isOrgMember(orgId) && orgSociosListVisible(orgId));
        allow create: if isAuthenticated()
          && isValidSocioCreate(request.resource.data)
          && orgHasSocioRoster(orgId)
          && (
               (request.resource.data.kind == 'typed'
                 && isOrgAdmin(orgId)
                 && request.resource.data.personId == null
                 && request.resource.data.responsibleUid == null)
               || (request.resource.data.kind == 'persona'
                 && isOrgMember(orgId)
                 && request.resource.data.responsibleUid == request.auth.uid
                 && request.resource.data.personId is string
                 // The junta numbers socios; a member's persona waits for
                 // assignSocioNumber.
                 && request.resource.data.socioNumber == null
                 // A member writes the alta of their own persona: keep it to now.
                 && request.resource.data.altaAt > request.time - duration.value(5, 'm')
                 && request.resource.data.altaAt < request.time + duration.value(5, 'm')
                 && isEligiblePersona(request.resource.data.personId)
                 // One active row per persona: its lock is created in the same
                 // batch, and a lock create fails while another row holds it.
                 && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socioPersonaLocks/$(request.resource.data.personId)).data.socioId == socioId)
             );
        allow update: if (
             // An admin numbers or renumbers any row, bajas included: the libro
             // is theirs to correct.
             isOrgAdmin(orgId)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['socioNumber'])
               && isValidSocioNumber(request.resource.data.socioNumber)
        ) || (isAuthenticated() && resource.data.bajaAt == null && (
             // Baja: a persona by its responsible member or an admin; a typed
             // socio by an admin. Stamped with the server's clock.
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bajaAt'])
               && request.resource.data.bajaAt == request.time
               && ((resource.data.kind == 'persona'
                     && (resource.data.responsibleUid == request.auth.uid || isOrgAdmin(orgId))
                     // The baja frees the persona's lock in the same write.
                     && !existsAfter(/databases/$(database)/documents/organizations/$(orgId)/socioPersonaLocks/$(resource.data.personId)))
                   || (resource.data.kind == 'typed' && isOrgAdmin(orgId))))
             // An admin corrects a typed-in socio's name (and number).
          || (resource.data.kind == 'typed'
               && isOrgAdmin(orgId)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'socioNumber'])
               && isValidSocioNumber(request.resource.data.socioNumber)
               && isString(request.resource.data.displayName)
               && request.resource.data.displayName.size() > 0
               && request.resource.data.displayName.size() <= 200)
             // An admin gives an admin a display title (no powers), or clears it.
          || (resource.data.kind == 'member'
               && isOrgAdmin(orgId)
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminTitle'])
               && (request.resource.data.adminTitle == null
                   || (request.resource.data.adminTitle in ['presidente', 'secretario', 'tesorero', 'vocal', 'otro']
                       && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(resource.data.uid)).data.role == 'admin')))
        ));
        allow delete: if false;
      }

      // The last socio number assignSocioNumber handed out. Function-owned.
      match /socioNumbering/{docId} {
        allow read, write: if false;
      }

      // While a persona is an active socio, its lock names the row (see
      // SocioPersonaLockDataSchema). Written only in the batch that creates or
      // gives the baja to that row; never updated, so a second add fails.
      match /socioPersonaLocks/{personId} {
        allow read: if isOrgAdmin(orgId);
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['socioId'])
          && request.resource.data.socioId is string
          && !exists(/databases/$(database)/documents/organizations/$(orgId)/socios/$(request.resource.data.socioId))
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(request.resource.data.socioId)).data.kind == 'persona'
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(request.resource.data.socioId)).data.personId == personId
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(request.resource.data.socioId)).data.responsibleUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAuthenticated()
          && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(resource.data.socioId)).data.bajaAt != null
          && (get(/databases/$(database)/documents/organizations/$(orgId)/socios/$(resource.data.socioId)).data.responsibleUid == request.auth.uid
              || isOrgAdmin(orgId));
      }

      // A socio's phone and email. Only the org's admins and the socio read it
      // (AEPD 0514/2009: socios don't see each other's contact data). A member
      // writes their own answer to "what may the junta see"; an admin writes a
      // typed-in socio's. getAfter so the typed row and this doc can land in one
      // batch.
      match /socioPrivate/{socioId} {
        allow read: if isOrgAdmin(orgId)
          || (isAuthenticated()
              && get(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data.uid == request.auth.uid);
        allow create, update: if isAuthenticated()
          && isValidSocioPrivate(request.resource.data)
          && (
               (getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data.kind == 'typed'
                 && isOrgAdmin(orgId)
                 && request.resource.data.consentAnsweredAt == null)
               || (getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data.kind == 'member'
                 && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data.uid == request.auth.uid
                 && getAfter(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId)).data.bajaAt == null
                 && request.resource.data.consentAnsweredAt is timestamp)
             );
        allow delete: if false;
      }

      // The cuota de socios (see CuotaDataModel). Cultuvilla moves no money:
      // admins configure the cuota and record payments made off-app. The
      // settings carry how to pay, so members read them; status is computed on
      // read, never stored.
      match /cuotaSettings/{docId} {
        allow read: if isOrgMember(orgId);
        allow create, update: if isOrgAdmin(orgId)
          && docId == 'current'
          && orgHasSocioRoster(orgId)
          && isValidCuotaSettings(request.resource.data);
        allow delete: if false;
      }

      // A socio's tier, exemption or custom amount, keyed by socio id.
      match /cuotaAssignments/{socioId} {
        allow read: if isOrgAdmin(orgId) || isMySocioRow(orgId, socioId);
        allow create, update: if isOrgAdmin(orgId)
          && exists(/databases/$(database)/documents/organizations/$(orgId)/socios/$(socioId))
          && isValidCuotaAssignment(request.resource.data);
        allow delete: if false;
      }

      // The payment ledger. Append-only: no entry is ever edited or deleted. A
      // mistake is cancelled by a reversal at `rev_<paymentId>` that copies the
      // payment — the fixed id means a payment can be reversed only once.
      match /cuotaPayments/{paymentId} {
        allow read: if isOrgAdmin(orgId) || isMySocioRow(orgId, resource.data.socioId);
        allow create: if isOrgAdmin(orgId)
          && isValidCuotaPayment(request.resource.data)
          && exists(/databases/$(database)/documents/organizations/$(orgId)/socios/$(request.resource.data.socioId))
          && (
               (request.resource.data.kind == 'payment' && request.resource.data.reversesId == null)
               || (request.resource.data.kind == 'reversal'
                 && request.resource.data.reversesId is string
                 && paymentId == 'rev_' + request.resource.data.reversesId
                 && get(/databases/$(database)/documents/organizations/$(orgId)/cuotaPayments/$(request.resource.data.reversesId)).data.kind == 'payment'
                 && get(/databases/$(database)/documents/organizations/$(orgId)/cuotaPayments/$(request.resource.data.reversesId)).data.socioId == request.resource.data.socioId
                 && get(/databases/$(database)/documents/organizations/$(orgId)/cuotaPayments/$(request.resource.data.reversesId)).data.periodKey == request.resource.data.periodKey
                 && get(/databases/$(database)/documents/organizations/$(orgId)/cuotaPayments/$(request.resource.data.reversesId)).data.amountCents == request.resource.data.amountCents)
             );
        allow update, delete: if false;
      }

      // What the sendCuotaReminders job sent, per socio per period. Function-owned.
      match /cuotaReminders/{reminderId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }

      // The group's tasks (see GroupTaskDataModel), every org type. Every
      // member sees, creates, edits and ticks them (decided 2026-11-01, user);
      // deleting one is for admins and whoever created it. The answer lists
      // and the next occurrence stay function-owned.
      match /tasks/{taskId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) && isValidGroupTaskCreate(request.resource.data);
        allow update: if isOrgMember(orgId) && isValidGroupTaskUpdate(request.resource.data, resource.data);
        allow delete: if isOrgAdmin(orgId) || (isOrgMember(orgId) && resource.data.createdBy == request.auth.uid);
      }

      // Checklists dated relative to an anchor. Admins only.
      match /taskTemplates/{templateId} {
        allow read, delete: if isOrgAdmin(orgId);
        allow create, update: if isOrgAdmin(orgId) && isValidTaskTemplate(request.resource.data);
      }

      // What the sendGroupTaskReminders job sent, per task, stage and member. Function-owned.
      match /taskReminders/{reminderId} {
        allow read: if isOrgAdmin(orgId);
        allow write: if false;
      }

      // A group's messages (see GroupMessageDataModel). Written only by the
      // sendGroupMessage / nudgeGroupMessage callables; an admin may only
      // (un)pin one. A recipient with the app reads it while still a member —
      // `recipientUids` is what the member's array-contains query proves.
      match /messages/{messageId} {
        allow read: if isOrgAdmin(orgId)
          || (isOrgMember(orgId) && request.auth.uid in resource.data.recipientUids);
        allow update: if isOrgAdmin(orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])
          && request.resource.data.pinned is bool;
        allow create, delete: if false;

        // Per recipient: names socios and their channels, so admins only. The
        // one client write is the WhatsApp tick the admin makes by hand.
        match /deliveries/{recipientKey} {
          allow read: if isOrgAdmin(orgId);
          allow update: if isOrgAdmin(orgId)
            && resource.data.whatsappSocioId != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['whatsappSentAt', 'whatsappSentBy'])
            && ((request.resource.data.whatsappSentAt == request.time && request.resource.data.whatsappSentBy == request.auth.uid)
                || (request.resource.data.whatsappSentAt == null && request.resource.data.whatsappSentBy == null));
          allow create, delete: if false;
        }

        // A recipient opened it. Once: a read is never undone.
        match /reads/{uid} {
          allow read: if isOrgAdmin(orgId) || isOwner(uid);
          allow create: if isOwner(uid)
            && isOrgMember(orgId)
            && uid in groupMessage(orgId, messageId).recipientUids
            && request.resource.data.keys().hasOnly(['readAt'])
            && request.resource.data.readAt == request.time;
          allow update, delete: if false;
        }

        // One vote per account; a second vote replaces the first. Who voted
        // what is the junta's to see (admins), never the other socios'.
        match /votes/{uid} {
          allow read: if isOrgAdmin(orgId) || isOwner(uid);
          allow create, update: if isOwner(uid)
            && isOrgMember(orgId)
            && isValidGroupPollVote(groupMessage(orgId, messageId), uid, request.resource.data);
          allow delete: if false;
        }
      }

      // The group's chat (see GroupChatDataModel). Both threads are written by
      // clients directly; onGroupChatMessageCreated keeps chatThreads and pushes.
      match /chat/{chatId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId)
          && isValidGroupChatMessageCreate(request.resource.data)
          && (!orgChatAdminsOnly(orgId) || isOrgAdmin(orgId));
        allow update: if false;
        allow delete: if canDeleteGroupChatMessage(orgId, resource.data);
      }

      match /messages/{messageId}/chat/{chatId} {
        allow read: if canReadAvisoChat(orgId, messageId);
        allow create: if canReadAvisoChat(orgId, messageId)
          && isValidGroupChatMessageCreate(request.resource.data);
        allow update: if false;
        allow delete: if canDeleteGroupChatMessage(orgId, resource.data);
      }

      // Per thread (an aviso's id, or `general`): when it last moved and who
      // wrote in it. Function-owned. A reader's last open moves forward only.
      match /chatThreads/{threadId} {
        allow read: if canReadGroupChatThread(orgId, threadId);
        allow write: if false;

        match /reads/{uid} {
          allow read: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && canReadGroupChatThread(orgId, threadId)
            && request.resource.data.keys().hasOnly(['readAt'])
            && request.resource.data.readAt == request.time;
          allow delete: if false;
        }
      }

      // Meeting minutes (see ActaDataSchema in RecordsDataModel). Admins write
      // and correct them; a socio reads one only once an admin shares it.
      // Members must query with `visibleToSocios == true` for the list to pass.
      match /actas/{actaId} {
        allow read: if isOrgAdmin(orgId)
          || (isOrgMember(orgId) && resource.data.visibleToSocios == true);
        allow create: if isOrgAdmin(orgId)
          && orgHasSocioRoster(orgId)
          && isValidActaCreate(request.resource.data);
        allow update: if isOrgAdmin(orgId)
          && isValidActaFields(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt']);
        allow delete: if isOrgAdmin(orgId);
      }

      // Income and expenses beyond the cuota. Append-only like cuotaPayments: a
      // mistake is cancelled by a reversal at `rev_<entryId>` that copies the
      // entry, so an entry is reversed at most once and a reversal never.
      match /ledgerEntries/{entryId} {
        allow read: if isOrgAdmin(orgId);
        allow create: if isOrgAdmin(orgId)
          && orgHasSocioRoster(orgId)
          && isValidLedgerEntry(request.resource.data)
          && (
               request.resource.data.reversesId == null
               || (entryId == 'rev_' + request.resource.data.reversesId
                 && get(/databases/$(database)/documents/organizations/$(orgId)/ledgerEntries/$(request.resource.data.reversesId)).data.reversesId == null
                 && get(/databases/$(database)/documents/organizations/$(orgId)/ledgerEntries/$(request.resource.data.reversesId)).data.kind == request.resource.data.kind
                 && get(/databases/$(database)/documents/organizations/$(orgId)/ledgerEntries/$(request.resource.data.reversesId)).data.amountCents == request.resource.data.amountCents
                 && get(/databases/$(database)/documents/organizations/$(orgId)/ledgerEntries/$(request.resource.data.reversesId)).data.on == request.resource.data.on)
             );
        allow update, delete: if false;
      }

      // A pending request to join an `approval` org, keyed by the requester's
      // uid. Filed and withdrawn by the requester; resolved only by the
      // respondToOrgJoinRequest callable (Admin SDK), which adds the member,
      // audits it and notifies the requester — so no client edits it.
      match /joinRequests/{userId} {
        allow read: if isOwner(userId)
          || isOrgAdmin(orgId)
          || isVillageAdmin(orgMunicipalityId(orgId))
          || isAppAdmin();
        allow create: if isOwner(userId)
          && isValidOrgJoinRequestCreate(request.resource.data, orgId, userId)
          && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'approved'
          && !isOrgMember(orgId);
        allow update: if false;
        allow delete: if isOwner(userId)
          || isOrgAdmin(orgId)
          || isVillageAdmin(orgMunicipalityId(orgId))
          || isAppAdmin();
      }

      // Following a group: a free tap, no approval, and no tie to the roster.
      // Who follows is not public — the count on the org doc is what the pueblo
      // sees. `followerCount` is function-owned (syncOrgFollowerCount).
      match /followers/{userId} {
        allow read: if isOwner(userId)
          || isOrgAdmin(orgId)
          || isVillageAdmin(orgMunicipalityId(orgId))
          || isAppAdmin();
        allow create: if isOwner(userId)
          && isValidOrgFollowerCreate(request.resource.data, orgId, userId)
          && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'approved'
          && !isOrgMember(orgId);
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /events/{eventId} {
      // `resource == null` keeps a read of a missing event returning
      // "doesn't exist" rather than permission-denied — a link to a deleted
      // event must 404, not look like a private one.
      allow read: if resource == null || canReadEvent(resource.data);
      allow create: if isAuthenticated()
        && isValidEventCreate(request.resource.data)
        && isOwnSeriesOccurrence(eventId, request.resource.data)
        && request.resource.data.municipalityId is string
        && request.resource.data.createdBy == request.auth.uid
        && isVillageMember(request.resource.data.municipalityId)
        && (request.auth.uid in request.resource.data.organizerUserIds)
        // You can only make an event private to an org you belong to —
        // otherwise anyone could park content inside someone else's peña.
        && (request.resource.data.visibilityOrgId == null
            || isOrgMember(request.resource.data.visibilityOrgId));
      allow update: if (
           isOwner(resource.data.createdBy)
        || (request.auth.uid in resource.data.organizerUserIds)
        || isVillageAdmin(resource.data.municipalityId)
        || isAppAdmin()
      )
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.municipalityId == resource.data.municipalityId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount', 'readCount', 'villageSlug', 'series'])
        && isAdditiveSignupFieldsChange(resource.data, request.resource.data)
        && isFrozenGroupSizeChange(resource.data, request.resource.data)
        && isValidVisibilityChange(resource.data, request.resource.data)
        && isValidRepeatsYearly(request.resource.data)
        // A series shares one visibility: "este y los siguientes" finds its
        // siblings within it, and a day made private on its own would split it.
        && (resource.data.get('series', null) == null
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibility', 'visibilityOrgId']));
      allow delete: if isOwner(resource.data.createdBy)
        || (request.auth.uid in resource.data.organizerUserIds)
        || isVillageAdmin(resource.data.municipalityId)
        || isAppAdmin();

      match /registrations/{regId} {
        // A roster names real people, so it is village-scoped, never world-
        // readable: a guest-readable list would publish the names of dependent
        // personas (typically children) whose person doc is deliberately
        // private. Three ways in, in cost order:
        //   1. the organizer set / admins — always, whatever the visibility;
        //   2. any member of the event's pueblo, when attendeesVisibility is
        //      'members' (the default);
        //   3. your own row — a visitor from another pueblo signs up too
        //      (that is what `isMember: false` records) and must still be able
        //      to read and cancel their registration. Per-document, so a list
        //      only passes this branch when filtered on userId.
        //   4. seats you booked — once a guest claims an open seat `userId`
        //      moves to them, but you are still accountable for the seat and
        //      still the one who can cancel the group, so you must be able to
        //      see it. Per-document, so a list only passes this branch when
        //      filtered on groupOwnerId.
        allow read: if isEventOrganizer(eventId)
          || isRosterVisibleToVillage(eventId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid)
          || (isAuthenticated() && resource.data.groupOwnerId == request.auth.uid);
        // Creation goes through the `registerToEvent` callable (admin SDK
        // bypasses rules). Direct client writes are not trusted because the
        // capacity/waitlist decision must be made server-side in a
        // transaction.
        allow create: if false;
        // Self may update their own registration; an organizer may too
        // (check-in via `checkedInAt`, or removing a no-show / walk-in).
        // EXCEPTION: writes touching `paidAt` are the paid register and are
        // organizer-only — a registrant must not be able to self-mark paid.
        allow update: if (
             (isAuthenticated() && resource.data.userId == request.auth.uid)
          || isEventOrganizer(eventId)
        ) && (
          // The capacity/waitlist decision is made server-side in a
          // transaction by registerToEvent; `status` and `position` are that
          // decision's output. Self-writable, a waitlisted attendee could
          // simply promote themselves past maxAttendees. `isMember` and the
          // identity fields are likewise not the registrant's to restate.
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'paidAt', 'status', 'position', 'isMember', 'userId', 'personId',
            // Group membership is the seating decision's output too. Writable
            // by the holder, an attendee could detach their seat from its
            // group (escaping the cascade) or mark an occupied seat open and
            // hand it to a stranger.
            'groupId', 'groupOwnerId', 'isOpenSeat',
          ])
          || isEventOrganizer(eventId)
        );
        // Cancellation goes through the `cancelRegistration` callable. A group
        // is atomic, so removing one seat must take the whole group or none of
        // it — rules can neither read the sibling seats nor require that the
        // companion deletes accompany this one, so no client delete can be
        // trusted. See functions/src/events/cancelRegistration.ts.
        allow delete: if false;
      }

      // Claim tokens for open group seats. THE DOCUMENT ID IS THE SECRET, so
      // reading one is enough to take the seat it names: the group owner may
      // re-read their own (to re-share the link) and organizers may audit, and
      // nobody else gets near them. Writes are callable-only — minting a token
      // is minting an authorization.
      match /seatTokens/{tokenId} {
        allow read: if isAuthenticated()
          && (resource.data.createdBy == request.auth.uid || isEventOrganizer(eventId));
        allow write: if false;
      }

      // Append-only audit log of the roster: who joined, who left, and who
      // removed them. Cancellation is a hard delete, so without this the
      // organizer has no record that a departed attendee ever existed. Same
      // audience as the ops on the roster — organizers, village admins, app
      // admins — and never the pueblo, because it names people who are no
      // longer on the (already village-scoped) list. Written only by the
      // registration callables via the admin SDK.
      match /registrationEvents/{entryId} {
        allow read: if isEventOrganizer(eventId);
        allow write: if false;
      }

      // Organizer-only private data per registration: the attendee's phone and
      // their answers to the event's custom signupFields. The registration doc
      // itself is world-readable, so all PII lives here instead. Written only
      // by callables (admin SDK); no client write is ever trusted.
      match /registrationPrivate/{regId} {
        allow read: if isEventOrganizer(eventId);
        allow write: if false;
      }
    }

    // persons — canonical people registry
    match /persons/{personId} {
      // Public read: person profiles are shareable links viewable by guests
      // (parity with events/orgs/users, all already world-readable). A creator
      // can mark a dependent persona private, which takes the doc out of that
      // public read — the name still appears in village rosters, which read the
      // function-owned municipalityPeople projection, but the card itself is
      // only readable by its person, its creator, and app admins.
      //
      // This clause is evaluated per document, so a query over persons only
      // succeeds if every matched doc passes: list queries that aren't scoped
      // to the caller must filter on isPublic (see personService).
      allow read: if resource.data.isPublic == true
        || (isAuthenticated() && (
             resource.data.userId == request.auth.uid
             || resource.data.createdBy == request.auth.uid
             || isAppAdmin()
           ));
      // `createdBy` pins who authored the doc; `userId` pins who it *is*, and
      // syncPersonDenormalization projects this doc's name onto
      // users/{userId}.displayName with the admin SDK — bypassing these rules.
      // So an unconstrained `userId` is a write primitive against another
      // account's profile. A persona may claim nobody (null) or its own owner,
      // never a third party.
      allow create: if isAuthenticated()
        && isValidPersonCreate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid)
        && isPublicUnlessDependent(request.resource.data);
      allow update: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          || (resource.data.createdBy == request.auth.uid && resource.data.userId == null)
          || isAppAdmin()
        )
        && (request.resource.data.userId == resource.data.userId
            || request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid
            || isAppAdmin())
        && isPublicUnlessDependent(request.resource.data);
      allow delete: if isAuthenticated()
        && (
          (resource.data.createdBy == request.auth.uid && resource.data.userId == null)
          || isAppAdmin()
        );
    }

    // Municipality-scoped projection of persons/{personId}. Function-owned so
    // a client can never forge or change directory membership.
    match /municipalityPeople/{directoryId} {
      allow read: if isVillageMember(resource.data.municipalityId) || isAppAdmin();
      allow write: if false;
    }

    // villageWrapped — the post-fiestas summary, one doc per village + year,
    // covering every fiesta block of that year. Function-owned end to end: it
    // is computed, rendered and published by Cloud Functions, and released or
    // binned through respondToVillageWrapped, never by a client write.
    //
    // A published Wrapped reads publicly because the images it points at are
    // made to be forwarded — a recipient who is not a member, or not signed in,
    // must still be able to open the link. A draft is the admins' to decide on
    // and is readable only by them.
    //
    // The `resource == null` clause is load-bearing, not defensive noise, and it
    // must come first so `||` short-circuits past the dereferences below. Every
    // other clause reads the stored doc, so on an id that holds no document
    // `resource.data.status` raises a Null value error -- and an error in rules
    // is a denial, never a `false` that falls through to the admin clause.
    // "No Wrapped yet" is the normal state of a village and precisely the state
    // the admin's create screen exists to resolve, so it has to be observable:
    // without this, an admin asking "is there a 2026 one?" got permission-denied
    // and the screen hung on a spinner forever.
    //
    // A missing doc has no content to protect, so this grants nothing: a
    // not-found says only that the id holds nothing. It does let a stranger
    // tell "an undecided draft exists" (denied) from "none was ever built"
    // (not-found), since ids are the deterministic {municipalityId}_{year} --
    // existence, never content, and worth it to make the create screen work.
    match /villageWrapped/{wrappedId} {
      allow read: if resource == null
        || resource.data.status == 'published'
        || isVillageAdmin(resource.data.municipalityId)
        || isAppAdmin();
      allow write: if false;
    }

    // festivalPosters — top-level, scoped by municipalityId field (mirrors
    // the /places proposal pattern: members propose, admins/app-admins
    // approve/reject and may act directly).
    match /festivalPosters/{posterId} {
      allow read: if true;
      allow create: if isAppAdmin()
        || isVillageAdmin(request.resource.data.municipalityId)
        || (
             isVillageMember(request.resource.data.municipalityId)
             && isValidFestivalPosterCreate(request.resource.data)
             && request.resource.data.proposedBy == request.auth.uid
           );
      // status/hiddenBy/hiddenAt/hiddenReason and the interaction counters
      // (commentCount/readCount) are function-owned (see setContentVisibility
      // and the interaction count triggers) — clients may never touch them here.
      allow update: if (isVillageAdmin(resource.data.municipalityId) || isAppAdmin() || isOwner(resource.data.proposedBy))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'status', 'hiddenBy', 'hiddenAt', 'hiddenReason',
             'commentCount', 'readCount',
             // Unlike places/barrios (nested, so the path fixes the village),
             // a poster is top-level and this rule reads municipalityId for
             // authority — mutable, it walks the doc into another pueblo.
             'proposedBy', 'municipalityId', 'villageSlug',
           ]);
      allow delete: if isVillageAdmin(resource.data.municipalityId) || isAppAdmin()
        || (isOwner(resource.data.proposedBy) && resource.data.status == 'active');
    }

    // Collection-group queries: these rules are evaluated for CG list
    // operations on the named sub-collection regardless of which parent
    // collection they live under. "allow read: if true" on nested paths
    // allows single-doc gets but does NOT satisfy list operations on a
    // collection-group in Firestore Rules v2.

    // Member docs are individually public (allow read: if true), so any
    // authenticated user may also list member rows across collection groups
    // (e.g. to show another user's villages on their profile). Firestore
    // rules cannot express "filtered to a single userId", so this also
    // permits an unfiltered dump of all member rows to any signed-in caller
    // — an accepted tradeoff since the underlying docs are already public.
    match /{path=**}/members/{userId} {
      allow list: if isAuthenticated();
    }

    // Cross-event listing stays restricted to the caller's own rows. The
    // per-event rule above also lets a village member list one event's roster,
    // but that is scoped by the event's municipality — a collection-group
    // query has no event in its path to scope by, so it cannot reuse it.

    // A requester's own pending join requests, across every org.
    match /{path=**}/joinRequests/{requestId} {
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /{path=**}/registrations/{regId} {
      allow list: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
    }

    // _admin/** is server-only operational state: backfill completion markers
    // at _admin/backfills/markers/{id}, the store-review sign-in credential at
    // _admin/reviewAccess, and anything added later.
    // The Admin SDK bypasses rules, so the backfill harness writes these fine;
    // clients must never read or write them. Default-deny already blocks an
    // unmatched path — this explicit rule makes the invariant assertable and
    // stops a future broad rule from accidentally exposing operational state.
    match /_admin/{document=**} {
      allow read, write: if false;
    }

    // pushQueue is the server-only spool that turns a notification doc into a
    // device push (see PushQueueDataModel). Nothing in the app reads it, and a
    // client-writable spool would let anyone send themselves — or suppress —
    // an arbitrary push. The Admin SDK bypasses rules, so the triggers write it
    // fine.
    match /pushQueue/{queueId} {
      allow read, write: if false;
    }

    // Web studio sign-in pairings (StudioPairing model). Only the pairing
    // callables touch them: a readable pairing would hand its approved user's
    // session to anyone holding the id, which rides in a public QR code.
    match /studioPairings/{pairingId} {
      allow read, write: if false;
    }

    // The nightly ranking of active pueblos by how much they have to show
    // (refreshVillageRanking). Public: a guest's village page lists other
    // pueblos from it. Function-owned, so no client can rank its own pueblo up.
    match /villageRankings/{rankingId} {
      allow read: if true;
      allow write: if false;
    }

    // Public read-only app config (force-update gate). Written by admin/seed
    // script via the admin SDK, never by clients.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // occupations — collected free-text tally (doc id = slug), low-risk
    // reference data. Any authenticated client may upsert count/name/
    // updatedAt via recordOccupation; not moderated.
    match /occupations/{occupationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
